<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>comparisontool</AssemblyName>
        <RootNamespace>ComparisonTool.Cli</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Settings.Configuration" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="DiffPlex" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ComparisonTool.Core\ComparisonTool.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
    </ItemGroup>

    <PropertyGroup>
        <BlazorReportAssetsSourceDir Condition="'$(BlazorReportAssetsSourceDir)' == ''">
            $([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\ComparisonTool.Report\bin\publish\wwwroot\'))
        </BlazorReportAssetsSourceDir>
    </PropertyGroup>

    <Target Name="CopyBlazorReportAssetsToBuildOutput" AfterTargets="Build" Condition="Exists('$(BlazorReportAssetsSourceDir)')">
        <ItemGroup>
            <BlazorReportAssetsFiles Include="$(BlazorReportAssetsSourceDir)**\*" />
        </ItemGroup>
        <Message Text="Copying $(BlazorReportAssetsSourceDir) -> $(OutputPath)BlazorReportAssets\" Importance="High" />
        <Copy SourceFiles="@(BlazorReportAssetsFiles)" DestinationFiles="@(BlazorReportAssetsFiles->'$(OutputPath)BlazorReportAssets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <Message Text="Finished copying Blazor report assets." Importance="High" />
    </Target>

    <Target Name="CopyBlazorReportAssetsToPublishOutput" AfterTargets="Publish" Condition="Exists('$(BlazorReportAssetsSourceDir)')">
        <ItemGroup>
            <BlazorReportAssetsFiles Include="$(BlazorReportAssetsSourceDir)**\*" />
        </ItemGroup>
        <Message Text="Copying $(BlazorReportAssetsSourceDir) -> $(PublishDir)BlazorReportAssets\" Importance="High" />
        <Copy SourceFiles="@(BlazorReportAssetsFiles)" DestinationFiles="@(BlazorReportAssetsFiles->'$(PublishDir)BlazorReportAssets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <Message Text="Finished copying Blazor report assets." Importance="High" />
    </Target>

    <Target Name="ValidateBlazorReportAssets" BeforeTargets="CopyBlazorReportAssetsToBuildOutput;CopyBlazorReportAssetsToPublishOutput"Condition="'$(BlazorReportAssetsSourceDir)' != '' AND !Exists('$(BlazorReportAssetsSourceDir)')">
        <Warning Text="Blazor report assets source directory '$(BlazorReportAssetsSourceDir)' does not exist. Blazor report assets will not be copied." />
    </Target>

</Project>
