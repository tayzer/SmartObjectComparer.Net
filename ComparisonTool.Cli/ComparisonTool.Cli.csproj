<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>comparisontool</AssemblyName>
        <RootNamespace>ComparisonTool.Cli</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Settings.Configuration" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.CommandLine" />
      <PackageReference Include="DiffPlex" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ComparisonTool.Core\ComparisonTool.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
    </ItemGroup>

  <PropertyGroup>
    <BlazorReportPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\ComparisonTool.Report\bin\publish\wwwroot\'))</BlazorReportPublishDir>
  </PropertyGroup>

  <!-- Publishes the Blazor Report WASM project to generate static assets.
       Only runs if the _framework directory doesn't exist (first build or after clean).
       If ComparisonTool.Report source changes, delete ComparisonTool.Report\bin\publish\ to force re-publish,
       or run: dotnet publish ComparisonTool.Report -c Release -o ComparisonTool.Report\bin\publish -->
  <Target Name="PublishBlazorReport" BeforeTargets="BeforeBuild" Condition="!Exists('$(BlazorReportPublishDir)_framework')">
    <Exec Command="dotnet publish ..\ComparisonTool.Report\ComparisonTool.Report.csproj -c Release -o ..\ComparisonTool.Report\bin\publish" />
  </Target>

  <ItemGroup>
    <None Include="..\ComparisonTool.Report\bin\publish\wwwroot\**\*" Link="BlazorReportAssets\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
