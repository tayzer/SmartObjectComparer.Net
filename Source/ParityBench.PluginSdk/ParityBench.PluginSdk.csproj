<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The only assembly a client plugin compiles against. It must stay free of
    Application/Engine/Infrastructure references so a plugin package cannot drag
    product internals into its own load context.
  -->
  <PropertyGroup>
    <AssemblyName>ParityBench.PluginSdk</AssemblyName>
    <RootNamespace>ParityBench.PluginSdk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
