{
    "ParityBench": {
        "RequestDefaults": {
            "FixtureBaseUrl": "http://localhost:5056"
        },
        "Observability": {
            "LogDurations": true,
            "LogExceptions": true,
            "PersistDiagnostics": true,
            "SlowPathThresholdMs": 1000,
            "MaxSlowPathEntries": 100,
            "MaxExceptionEntries": 100,
            "EnableDetailedCompareTiming": true
        }
    },
    "RequestComparison": {
        "Defaults": {
            "MaxConcurrency": 10,
            "TimeoutSeconds": 120
        }
    }
}
