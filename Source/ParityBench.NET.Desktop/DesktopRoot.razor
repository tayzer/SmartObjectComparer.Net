<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">ParityBench.NET</MudText>
    </MudAppBar>
    <MudMainContent Class="pa-4">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <RunHistory RunSelected="SelectRun" />
            </MudItem>
            <MudItem xs="12" md="8">
                <RunResult RunId="selectedRunId" />
            </MudItem>
        </MudGrid>
    </MudMainContent>
</MudLayout>

@code {
    private RunId? selectedRunId;

    private void SelectRun(RunId runId)
    {
        selectedRunId = runId;
    }
}