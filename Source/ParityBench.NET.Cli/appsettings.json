{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "ParityBench.NET": "Information"
    }
  },
  "ParityBench": {
    "RequestDefaults": {
      "FixtureBaseUrl": "http://localhost:5056"
    },
    "Observability": {
      "LogDurations": false,
      "LogExceptions": true,
      "PersistDiagnostics": false,
      "SlowPathThresholdMs": 1000,
      "MaxSlowPathEntries": 100,
      "MaxExceptionEntries": 100,
      "EnableDetailedCompareTiming": false
    }
  },
  "ClientCustomerLookup": {
    "Tokens": {
      "PrimaryTokenUrl": "http://localhost:5056/client/token/primary",
      "PrimaryTokenSubscriptionKey": "mock-primary-token-subscription-key",
      "FinalTokenUrl": "http://localhost:5056/client/token/final",
      "FinalTokenSubscriptionKey": "mock-final-token-subscription-key"
    }
  },
  "RequestComparison": {
    "EndpointOptions": {
      "AllowCustom": true,
      "Endpoints": [
        {
          "Id": "client/customer-lookup/soap",
          "Name": "Client Customer Lookup SOAP",
          "Url": "http://localhost:5056/client/customer-lookup/soap",
          "ContentType": "text/xml",
          "DefaultHeaders": {
            "SOAPAction": "urn:ClientCustomerLookup"
          }
        },
        {
          "Id": "client/customer-lookup/json",
          "Name": "Client Customer Lookup JSON",
          "Url": "http://localhost:5056/client/customer-lookup/json",
          "ContentType": "application/json",
          "DefaultHeaders": {
            "Ocp-Apim-Subscription-Key": "mock-endpoint-b-subscription-key"
          }
        }
      ]
    },
    "Profiles": {
      "ClientCustomerLookup": {
        "PresetId": "client-soap-json-token",
        "Label": "Client SOAP/JSON token customer lookup",
        "RequestDirectory": "Examples/ParityBench.NET.ManualRuns/client-soap-json-token/behaviors",
        "ResponseModel": "ClientCustomerLookupResponse",
        "ProfileId": "client.customer-lookup.soap-json.tokens.v1",
        "EndpointAId": "client/customer-lookup/soap",
        "EndpointBId": "client/customer-lookup/json"
      },
      "ClientCustomerLookupVolume": {
        "PresetId": "client-soap-json-token-volume",
        "Label": "Client SOAP/JSON token customer lookup (volume)",
        "RequestDirectory": "Examples/ParityBench.NET.ManualRuns/client-soap-json-token/volume",
        "ResponseModel": "ClientCustomerLookupResponse",
        "ProfileId": "client.customer-lookup.soap-json.tokens.v1",
        "EndpointAId": "client/customer-lookup/soap",
        "EndpointBId": "client/customer-lookup/json"
      }
    }
  }
}