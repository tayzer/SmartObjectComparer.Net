@inject IJSRuntime JS
@inject ParityBenchThemeState InjectedThemeState

<MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Class="pb-theme-toggle" aria-label="Theme mode">
    @foreach (ThemeMode mode in Enum.GetValues<ThemeMode>())
    {
        <MudTooltip Text="@GetTooltip(mode)">
            <MudIconButton Icon="@GetIcon(mode)"
                           Color="@(CurrentThemeState.Mode == mode ? Color.Primary : Color.Default)"
                           Variant="@(CurrentThemeState.Mode == mode ? Variant.Filled : Variant.Text)"
                           Size="Size.Small"
                           OnClick="@(() => SetModeAsync(mode))"
                           aria-label="@GetTooltip(mode)" />
        </MudTooltip>
    }
</MudButtonGroup>

@code {
    [CascadingParameter]
    public ParityBenchThemeState? ThemeState { get; set; }

    private ParityBenchThemeState CurrentThemeState => ThemeState ?? InjectedThemeState;

    private async Task SetModeAsync(ThemeMode mode)
    {
        CurrentThemeState.SetMode(mode);

        try
        {
            await JS.InvokeVoidAsync("parityBenchTheme.setStoredMode", mode.ToString());
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private static string GetIcon(ThemeMode mode) =>
        mode switch
        {
            ThemeMode.Light => Icons.Material.Filled.LightMode,
            ThemeMode.Dark => Icons.Material.Filled.DarkMode,
            _ => Icons.Material.Filled.Computer,
        };

    private static string GetTooltip(ThemeMode mode) =>
        mode switch
        {
            ThemeMode.Light => "Use light mode",
            ThemeMode.Dark => "Use dark mode",
            _ => "Use system theme",
        };
}
