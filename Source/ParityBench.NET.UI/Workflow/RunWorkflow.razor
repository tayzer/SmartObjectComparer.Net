    private void RefreshAvailableProfiles(bool clearInvalidSelection)
    {
        availableProfileOptions = defaults.ContractProfiles
            .Where(profile => string.Equals(profile.ResponseModelName, modelName, StringComparison.Ordinal))
            .ToArray();
        RefreshSelectedProfile();

        if (clearInvalidSelection && !string.IsNullOrWhiteSpace(contractProfileId) && selectedProfileOption is null)
        {
            contractProfileId = string.Empty;
            RefreshSelectedProfile();
        }
    }

    private void RefreshSelectedProfile()
    {
        selectedProfileOption = availableProfileOptions.FirstOrDefault(profile =>
            string.Equals(profile.ProfileId, contractProfileId, StringComparison.OrdinalIgnoreCase));

        if (selectedProfileOption is not null)
        {
            ApplyProfileForcedDefaults(selectedProfileOption.DefaultComparisonRules);
        }
    }

    // The executor always ORs profile defaults into the run's comparison options
    // (see BasicComparisonRunExecutor.CreateRunOptionsWithProfileDefaults), so a
    // profile-forced setting can never actually be switched off. Reflect that here
    // instead of showing a toggle that silently has no effect.
    private void ApplyProfileForcedDefaults(ComparisonRuleDefaults defaults)
    {
        ignoreCollectionOrder |= defaults.IgnoreCollectionOrder;
        ignoreStringCase |= defaults.IgnoreStringCase;
        ignoreTrailingWhitespace |= defaults.IgnoreTrailingWhitespaceAtEnd;
        treatNullAndEmptyCollectionsEqual |= defaults.TreatNullAndEmptyCollectionsAsEqual;
        ignoreXmlNamespaces |= defaults.IgnoreXmlNamespaces;
    }

    private bool IsIgnoreCollectionOrderForcedByProfile => ActiveDefaultComparisonRules?.IgnoreCollectionOrder == true;
    private bool IsIgnoreStringCaseForcedByProfile => ActiveDefaultComparisonRules?.IgnoreStringCase == true;
    private bool IsIgnoreTrailingWhitespaceForcedByProfile => ActiveDefaultComparisonRules?.IgnoreTrailingWhitespaceAtEnd == true;
    private bool IsTreatNullAndEmptyCollectionsForcedByProfile => ActiveDefaultComparisonRules?.TreatNullAndEmptyCollectionsAsEqual == true;
    private bool IsIgnoreXmlNamespacesForcedByProfile => ActiveDefaultComparisonRules?.IgnoreXmlNamespaces == true;

