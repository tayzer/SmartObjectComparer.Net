@using System.IO
@using ParityBench.NET.Application.Workflow
@using ParityBench.NET.Domain.Comparison
@using ParityBench.NET.Domain.ContractProfiles
@using ParityBench.NET.Domain.Requests
@inject IRunWorkflowViewDataSource DataSource
@inject IRequestSourcePicker SourcePicker

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h6">Request Comparison</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">Upload request files and compare responses from two endpoints.</MudText>
    </MudStack>

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
    }
    @if (successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@successMessage</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 1: Upload Request Files</MudText>
            @if (SourcePicker.IsAvailable)
            {
                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AttachFile"
                               Disabled="@isBusy"
                               OnClick="PickRequestFilesAsync">
                        Add Request Files
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               Disabled="@isBusy"
                               OnClick="PickRequestDirectoryAsync">
                        Add Request Folder
                    </MudButton>
                </MudStack>
            }
            <MudTextField T="string"
                          Label="Request Directory"
                          Value="requestDirectory"
                          ValueChanged="HandleRequestDirectoryChanged"
                          Immediate="true"
                          Variant="Variant.Outlined" />
            @if (!string.IsNullOrWhiteSpace(requestSourceDescription))
            {
                <MudText Typo="Typo.caption">@requestSourceDescription</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 2: Model &amp; Configuration</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Select Domain Model" @bind-Value="modelName" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Contract Profile" @bind-Value="contractProfileId" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Max Differences" @bind-Value="maxDifferences" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudExpansionPanels Elevation="0" MultiExpansion="true">
                <MudExpansionPanel Text="Comparison Options">
                    <MudStack Spacing="2">
                        <MudSwitch @bind-Value="ignoreCollectionOrder" Label="Ignore Collection Order" Color="Color.Primary" />
                        <MudSwitch @bind-Value="ignoreStringCase" Label="Ignore String Case" Color="Color.Primary" />
                        <MudSwitch @bind-Value="ignoreTrailingWhitespace" Label="Ignore Trailing Spaces/Tabs at End of Strings" Color="Color.Primary" />
                        <MudSwitch @bind-Value="treatNullAndEmptyCollectionsEqual" Label="Treat null and empty collections as equal" Color="Color.Primary" />
                        <MudSwitch @bind-Value="ignoreXmlNamespaces" Label="Ignore XML Namespaces" Color="Color.Primary" />
                    </MudStack>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Ignore Rules">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Ignore Paths" Lines="4" @bind-Value="ignoreRules" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Smart Ignores" Lines="4" @bind-Value="smartIgnoreRules" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Mask Rules" Lines="4" @bind-Value="maskRules" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 3: Configure Endpoints</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Endpoint A" @bind-Value="endpointA" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Endpoint B" @bind-Value="endpointB" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudExpansionPanels Elevation="0" MultiExpansion="true">
                <MudExpansionPanel Text="Custom Headers (Optional)">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Common Headers" Lines="4" @bind-Value="commonHeaders" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Endpoint A Headers" Lines="4" @bind-Value="endpointAHeaders" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Endpoint B Headers" Lines="4" @bind-Value="endpointBHeaders" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Advanced Options">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Content-Type Override" @bind-Value="contentTypeOverride" Immediate="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Request Timeout (seconds)" @bind-Value="timeoutSeconds" Immediate="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Max Concurrency" @bind-Value="maxConcurrency" Immediate="true" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 4: Run Comparison</MudText>
            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@(!CanStartComparison)"
                           OnClick="StartWorkflowAsync">
                    Start Comparison
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           Disabled="@(!CanCancel)"
                           OnClick="CancelRunAsync">
                    Cancel
                </MudButton>
            </MudStack>

            @if (currentRun is not null)
            {
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@GetPhaseIcon(currentRun.Status)" Color="@GetPhaseColor(currentRun.Status)" />
                        <MudText Typo="Typo.subtitle2" Color="@GetPhaseColor(currentRun.Status)">@currentRun.Status</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">@currentRun.Id.Value</MudText>
                    </MudStack>
                    <MudProgressLinear Color="@GetPhaseColor(currentRun.Status)" Value="currentRun.Progress.PercentComplete" Striped="@isRunning" Size="Size.Large" />
                    <MudText Typo="Typo.body2">@currentRun.Progress.Message</MudText>
                    @if (currentRun.Progress.CompletedItems is not null && currentRun.Progress.TotalItems is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@currentRun.Progress.CompletedItems of @currentRun.Progress.TotalItems</MudText>
                    }
                </MudStack>
            }

            @if (progressLog.Count > 0)
            {
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="@($"Activity Log ({progressLog.Count} events)")">
                        <MudList T="string" Dense="true" Style="max-height: 200px; overflow-y: auto;">
                            @foreach (string entry in progressLog.AsEnumerable().Reverse().Take(15))
                            {
                                <MudListItem T="string">@entry</MudListItem>
                            }
                        </MudList>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Static Report</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="5">
                    <MudTextField T="string" Label="Report Output" @bind-Value="reportOutputDirectory" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField T="string" Label="Report Assets" @bind-Value="reportAssetsDirectory" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@(!CanGenerateReport)" OnClick="GenerateReportAsync">Generate</MudButton>
                </MudItem>
            </MudGrid>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private const int PollDelayMilliseconds = 750;
    private string requestDirectory = string.Empty;
    private IReadOnlyList<string> sourceFiles = Array.Empty<string>();
    private string requestSourceDescription = string.Empty;
    private string endpointA = string.Empty;
    private string endpointB = string.Empty;
    private string timeoutSeconds = "30";
    private string maxConcurrency = "4";
    private string modelName = "Auto";
    private string contractProfileId = string.Empty;
    private string contentTypeOverride = string.Empty;
    private string maxDifferences = "100";
    private string ignoreRules = string.Empty;
    private string smartIgnoreRules = string.Empty;
    private string maskRules = string.Empty;
    private string commonHeaders = string.Empty;
    private string endpointAHeaders = string.Empty;
    private string endpointBHeaders = string.Empty;
    private string reportOutputDirectory = string.Empty;
    private string reportAssetsDirectory = string.Empty;
    private bool ignoreCollectionOrder;
    private bool ignoreStringCase;
    private bool ignoreTrailingWhitespace;
    private bool treatNullAndEmptyCollectionsEqual;
    private bool ignoreXmlNamespaces = true;
    private bool isBusy;
    private bool isRunning;
    private string? errorMessage;
    private string? successMessage;
    private ComparisonRun? currentRun;
    private readonly List<string> progressLog = new List<string>();

    [Parameter]
    public EventCallback<RunId> RunSelected { get; set; }

    [Parameter]
    public EventCallback<ComparisonRun> RunChanged { get; set; }

    private bool CanStartComparison => !isBusy && !isRunning;

    private bool CanCancel => currentRun is not null && isRunning && !isBusy;

    private bool CanGenerateReport => currentRun?.Status == RunStatus.Completed
        && !isBusy
        && !string.IsNullOrWhiteSpace(reportOutputDirectory);

    private void HandleRequestDirectoryChanged(string value)
    {
        requestDirectory = value;
        sourceFiles = Array.Empty<string>();
        requestSourceDescription = string.IsNullOrWhiteSpace(value) ? string.Empty : $"Selected request folder: {value}";
    }

    private async Task PickRequestDirectoryAsync()
    {
        string? selectedDirectory = await SourcePicker.PickRequestDirectoryAsync().ConfigureAwait(false);
        if (string.IsNullOrWhiteSpace(selectedDirectory))
        {
            return;
        }

        requestDirectory = selectedDirectory;
        sourceFiles = Array.Empty<string>();
        requestSourceDescription = $"Selected request folder: {selectedDirectory}";
    }

    private async Task PickRequestFilesAsync()
    {
        IReadOnlyList<string> selectedFiles = await SourcePicker.PickRequestFilesAsync().ConfigureAwait(false);
        if (selectedFiles.Count == 0)
        {
            return;
        }

        sourceFiles = selectedFiles;
        requestDirectory = GetCommonSourceDirectory(selectedFiles);
        requestSourceDescription = $"Selected {selectedFiles.Count} request files from {requestDirectory}";
    }

    private async Task StartWorkflowAsync()
    {
        try
        {
            isBusy = true;
            errorMessage = null;
            successMessage = null;
            progressLog.Clear();

            RequestComparisonRunRequest request = BuildRequest();
            currentRun = await DataSource.CreateRunFromDirectoryAsync(request).ConfigureAwait(false);
            RecordProgress(currentRun);
            await NotifyRunChangedAsync(currentRun).ConfigureAwait(false);

            bool started = await DataSource.StartRunAsync(currentRun.Id).ConfigureAwait(false);
            if (!started)
            {
                errorMessage = "Run is already active.";
                return;
            }

            isRunning = true;
            await PollUntilTerminalAsync(currentRun.Id).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
            isRunning = currentRun is not null && DataSource.IsRunning(currentRun.Id);
        }
    }

    private async Task CancelRunAsync()
    {
        if (currentRun is null)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;
            currentRun = await DataSource.CancelRunAsync(currentRun.Id).ConfigureAwait(false);
            RecordProgress(currentRun);
            isRunning = false;
            await NotifyRunChangedAsync(currentRun).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task GenerateReportAsync()
    {
        if (currentRun is null)
        {
            return;
        }

        try
        {
            isBusy = true;
            errorMessage = null;
            successMessage = null;
            StaticReportBundleWriteResult result = await DataSource
                .GenerateReportAsync(currentRun.Id, reportOutputDirectory, string.IsNullOrWhiteSpace(reportAssetsDirectory) ? null : reportAssetsDirectory)
                .ConfigureAwait(false);
            successMessage = $"Report written to {result.OutputDirectory}";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PollUntilTerminalAsync(RunId runId)
    {
        while (true)
        {
            await Task.Delay(PollDelayMilliseconds).ConfigureAwait(false);
            currentRun = await DataSource.LoadRunAsync(runId).ConfigureAwait(false);
            RecordProgress(currentRun);
            await NotifyRunChangedAsync(currentRun).ConfigureAwait(false);

            if (currentRun.IsTerminal)
            {
                isRunning = false;
                return;
            }
        }
    }

    private async Task NotifyRunChangedAsync(ComparisonRun run)
    {
        await RunSelected.InvokeAsync(run.Id).ConfigureAwait(false);
        await RunChanged.InvokeAsync(run).ConfigureAwait(false);
    }

    private RequestComparisonRunRequest BuildRequest()
    {
        if (!Uri.TryCreate(endpointA, UriKind.Absolute, out Uri? endpointAUri))
        {
            throw new InvalidOperationException("Endpoint A must be an absolute URL.");
        }

        if (!Uri.TryCreate(endpointB, UriKind.Absolute, out Uri? endpointBUri))
        {
            throw new InvalidOperationException("Endpoint B must be an absolute URL.");
        }

        int timeout = ParsePositiveInt(timeoutSeconds, "Timeout seconds");
        int concurrency = ParsePositiveInt(maxConcurrency, "Concurrency");
        int maxDifferenceCount = ParsePositiveInt(maxDifferences, "Max differences");

        ComparisonOptions comparisonOptions = new ComparisonOptions(
            ignoreCollectionOrder,
            ignoreStringCase,
            ignoreTrailingWhitespace,
            treatNullAndEmptyCollectionsEqual,
            ignoreXmlNamespaces,
            maxDifferenceCount,
            RunWorkflowRuleParser.ParseIgnoreRules(ignoreRules),
            RunWorkflowRuleParser.ParseSmartIgnoreRules(smartIgnoreRules),
            RunWorkflowRuleParser.ParseMaskRules(maskRules));
        RequestExecutionOptions executionOptions = new RequestExecutionOptions(contentTypeOverride);

        return new RequestComparisonRunRequest(
            requestDirectory,
            endpointAUri,
            endpointBUri,
            TimeSpan.FromSeconds(timeout),
            concurrency,
            modelName,
            comparisonOptions,
            executionOptions,
            string.IsNullOrWhiteSpace(contractProfileId) ? null : new ContractProfileSelection(contractProfileId),
            commonHeaders: ParseHeaders(commonHeaders),
            endpointAHeaders: ParseHeaders(endpointAHeaders),
            endpointBHeaders: ParseHeaders(endpointBHeaders),
            sourceFiles: sourceFiles.Count == 0 ? null : sourceFiles);
    }

    private void RecordProgress(ComparisonRun run)
    {
        string entry = $"{DateTimeOffset.Now:HH:mm:ss} {run.Status}: {run.Progress.Message}";
        if (progressLog.Count == 0 || !string.Equals(progressLog[^1], entry, StringComparison.Ordinal))
        {
            progressLog.Add(entry);
        }
    }

    private static string GetCommonSourceDirectory(IReadOnlyList<string> filePaths)
    {
        string? commonDirectory = null;
        foreach (string filePath in filePaths)
        {
            string? directory = Path.GetDirectoryName(Path.GetFullPath(filePath));
            if (string.IsNullOrWhiteSpace(directory))
            {
                continue;
            }

            commonDirectory = commonDirectory is null ? directory : GetCommonDirectory(commonDirectory, directory);
        }

        return commonDirectory ?? string.Empty;
    }

    private static string GetCommonDirectory(string firstDirectory, string secondDirectory)
    {
        string[] firstParts = firstDirectory.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        string[] secondParts = secondDirectory.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        int sharedLength = 0;
        while (sharedLength < firstParts.Length
            && sharedLength < secondParts.Length
            && string.Equals(firstParts[sharedLength], secondParts[sharedLength], StringComparison.OrdinalIgnoreCase))
        {
            sharedLength++;
        }

        return sharedLength == 0
            ? Path.GetPathRoot(firstDirectory) ?? firstDirectory
            : string.Join(Path.DirectorySeparatorChar, firstParts.Take(sharedLength));
    }

    private static string GetPhaseIcon(RunStatus status) =>
        status switch
        {
            RunStatus.Completed => Icons.Material.Filled.CheckCircle,
            RunStatus.Failed => Icons.Material.Filled.Error,
            RunStatus.Cancelled => Icons.Material.Filled.Cancel,
            RunStatus.Executing => Icons.Material.Filled.PlayArrow,
            RunStatus.Comparing => Icons.Material.Filled.CompareArrows,
            RunStatus.Analyzing => Icons.Material.Filled.Analytics,
            _ => Icons.Material.Filled.Sync,
        };

    private static Color GetPhaseColor(RunStatus status) =>
        status switch
        {
            RunStatus.Completed => Color.Success,
            RunStatus.Failed => Color.Error,
            RunStatus.Cancelled => Color.Warning,
            _ => Color.Primary,
        };

    private static int ParsePositiveInt(string value, string label)
    {
        if (!int.TryParse(value, out int parsed) || parsed <= 0)
        {
            throw new InvalidOperationException($"{label} must be a positive whole number.");
        }

        return parsed;
    }

    private static IReadOnlyDictionary<string, string> ParseHeaders(string text)
    {
        Dictionary<string, string> headers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (string rawLine in text.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            string line = rawLine.Trim();
            if (line.Length == 0)
            {
                continue;
            }

            int separatorIndex = line.IndexOf(':', StringComparison.Ordinal);
            if (separatorIndex <= 0)
            {
                throw new InvalidOperationException($"Header '{line}' must use Name: Value format.");
            }

            headers[line[..separatorIndex].Trim()] = line[(separatorIndex + 1)..].Trim();
        }

        return headers;
    }
}