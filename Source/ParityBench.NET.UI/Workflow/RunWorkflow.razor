    private static string FormatIgnoreRules(IReadOnlyList<IgnoreRuleDefinition> rules) =>
        string.Join(Environment.NewLine, rules.Select(rule => rule.PropertyPath));

    private static string FormatSmartIgnoreRules(IReadOnlyList<SmartIgnoreRuleDefinition> rules) =>
        string.Join(Environment.NewLine, rules.Select(rule => $"{rule.Kind}={rule.Value}"));

    private static string FormatMaskRules(IReadOnlyList<MaskRuleDefinition> rules) =>
        string.Join(Environment.NewLine, rules.Select(FormatMaskRule));

    private static string FormatMaskRule(MaskRuleDefinition rule)
    {
        List<string> segments = new List<string> { rule.PropertyPath };
        if (rule.PreserveLastCharacters > 0)
        {
            segments.Add($"preserveLast={rule.PreserveLastCharacters}");
        }

        if (!string.Equals(rule.MaskCharacter, "*", StringComparison.Ordinal))
        {
            segments.Add($"mask={rule.MaskCharacter}");
        }

        return string.Join("|", segments);
    }
    private void RecordProgress(ComparisonRun run)
    {
        string entry = $"{DateTimeOffset.Now:HH:mm:ss} {run.Status}: {run.Progress.Message}";
        if (progressLog.Count == 0 || !string.Equals(progressLog[^1], entry, StringComparison.Ordinal))
        {
            progressLog.Add(entry);
        }
    }

    private static string GetCommonSourceDirectory(IReadOnlyList<string> filePaths)
    {
        string? commonDirectory = null;
        foreach (string filePath in filePaths)
        {
            string? directory = Path.GetDirectoryName(Path.GetFullPath(filePath));
            if (string.IsNullOrWhiteSpace(directory))
            {
                continue;
            }

            commonDirectory = commonDirectory is null ? directory : GetCommonDirectory(commonDirectory, directory);
        }

        return commonDirectory ?? string.Empty;
    }

    private static string GetCommonDirectory(string firstDirectory, string secondDirectory)
    {
        string[] firstParts = firstDirectory.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        string[] secondParts = secondDirectory.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        int sharedLength = 0;
        while (sharedLength < firstParts.Length
            && sharedLength < secondParts.Length
            && string.Equals(firstParts[sharedLength], secondParts[sharedLength], StringComparison.OrdinalIgnoreCase))
        {
            sharedLength++;
        }

        return sharedLength == 0
            ? Path.GetPathRoot(firstDirectory) ?? firstDirectory
            : string.Join(Path.DirectorySeparatorChar, firstParts.Take(sharedLength));
    }

