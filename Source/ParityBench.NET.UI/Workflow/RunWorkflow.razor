@using System.IO
@using ParityBench.NET.Application.Workflow
@using ParityBench.NET.Domain.Comparison
@using ParityBench.NET.Domain.ContractProfiles
@using ParityBench.NET.Domain.Requests
@inject IRunWorkflowViewDataSource DataSource
@inject IRequestSourcePicker SourcePicker

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h6">Request Comparison</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">Upload request files and compare responses from two endpoints.</MudText>
    </MudStack>

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
    }
    @if (successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@successMessage</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 1: Upload Request Files</MudText>
            @if (defaults.Presets.Count > 0)
            {
                <MudSelect T="string"
                           Label="Example preset"
                           Value="selectedPresetId"
                           ValueChanged="HandlePresetChangedAsync"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    @foreach (RequestComparisonPresetOption preset in defaults.Presets)
                    {
                        <MudSelectItem T="string" Value="@preset.PresetId">@preset.Label</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (SourcePicker.IsAvailable)
            {
                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AttachFile"
                               Disabled="@isBusy"
                               OnClick="PickRequestFilesAsync">
                        Add Request Files
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               Disabled="@isBusy"
                               OnClick="PickRequestDirectoryAsync">
                        Add Request Folder
                    </MudButton>
                </MudStack>
            }
            <MudTextField T="string"
                          Label="Request Directory"
                          Value="requestDirectory"
                          ValueChanged="HandleRequestDirectoryChanged"
                          Immediate="true"
                          Variant="Variant.Outlined" />
            @if (!string.IsNullOrWhiteSpace(requestSourceDescription))
            {
                <MudText Typo="Typo.caption">@requestSourceDescription</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 2: Model &amp; Configuration</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string"
                                     Label="Select Domain Model"
                                     Value="modelName"
                                     ValueChanged="HandleModelChangedAsync"
                                     SearchFunc="SearchModelNamesAsync"
                                     Immediate="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="false"
                                     MaxItems="50"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string"
                                     Label="Contract Profile"
                                     Value="contractProfileId"
                                     ValueChanged="HandleProfileChangedAsync"
                                     SearchFunc="SearchProfileIdsAsync"
                                     Immediate="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="false"
                                     MaxItems="50"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Max Differences" @bind-Value="maxDifferences" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudExpansionPanels Elevation="0" MultiExpansion="true">
                <MudExpansionPanel Text="Comparison Options">
                    <MudStack Spacing="2">
                        @if (HasProfileDefaultComparisonRules(selectedProfileOption))
                        {
                            <MudStack Spacing="1" Class="mb-3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Profile default comparison rules</MudText>
                                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                    @foreach (string summary in GetProfileDefaultRuleSummary(selectedProfileOption!.DefaultComparisonRules))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@summary</MudChip>
                                    }
                                </MudStack>
                            </MudStack>
                        }
                        <MudSwitch @bind-Value="ignoreCollectionOrder" Label="Ignore Collection Order" Color="Color.Primary" />
                        <MudSwitch @bind-Value="ignoreStringCase" Label="Ignore String Case" Color="Color.Primary" />
                        <MudSwitch @bind-Value="ignoreTrailingWhitespace" Label="Ignore Trailing Spaces/Tabs at End of Strings" Color="Color.Primary" />
                        <MudSwitch @bind-Value="treatNullAndEmptyCollectionsEqual" Label="Treat null and empty collections as equal" Color="Color.Primary" />
                        <MudSwitch @bind-Value="ignoreXmlNamespaces" Label="Ignore XML Namespaces" Color="Color.Primary" />
                    </MudStack>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Ignore Rules">
                    @if (selectedProfileOption?.DefaultComparisonRules.IgnoreRules.Count > 0)
                    {
                        <MudStack Spacing="1" Class="mb-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Profile default ignore rules</MudText>
                            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                @foreach (IgnoreRuleDefinition rule in selectedProfileOption.DefaultComparisonRules.IgnoreRules)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@rule.PropertyPath</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                    }
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Ignore Paths" Lines="4" @bind-Value="ignoreRules" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Smart Ignores" Lines="4" @bind-Value="smartIgnoreRules" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Mask Rules" Lines="4" @bind-Value="maskRules" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 3: Configure Endpoints</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     Label="Endpoint A"
                                     Value="endpointA"
                                     ValueChanged="HandleEndpointAChanged"
                                     SearchFunc="SearchEndpointUrlsAsync"
                                     Immediate="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="false"
                                     MaxItems="50"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     Label="Endpoint B"
                                     Value="endpointB"
                                     ValueChanged="HandleEndpointBChanged"
                                     SearchFunc="SearchEndpointUrlsAsync"
                                     Immediate="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="false"
                                     MaxItems="50"
                                     Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudExpansionPanels Elevation="0" MultiExpansion="true">
                <MudExpansionPanel Text="Custom Headers (Optional)">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Common Headers" Lines="4" @bind-Value="commonHeaders" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Endpoint A Headers" Lines="4" @bind-Value="endpointAHeaders" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Endpoint B Headers" Lines="4" @bind-Value="endpointBHeaders" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Advanced Options">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Content-Type Override" @bind-Value="contentTypeOverride" Immediate="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Request Timeout (seconds)" @bind-Value="timeoutSeconds" Immediate="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField T="string" Label="Max Concurrency" @bind-Value="maxConcurrency" Immediate="true" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Step 4: Run Comparison</MudText>
            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@(!CanStartComparison)"
                           OnClick="StartWorkflowAsync">
                    Start Comparison
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           Disabled="@(!CanCancel)"
                           OnClick="CancelRunAsync">
                    Cancel
                </MudButton>
            </MudStack>

            @if (currentRun is not null)
            {
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@GetPhaseIcon(currentRun.Status)" Color="@GetPhaseColor(currentRun.Status)" />
                        <MudText Typo="Typo.subtitle2" Color="@GetPhaseColor(currentRun.Status)">@currentRun.Status</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">@currentRun.Id.Value</MudText>
                    </MudStack>
                    <MudProgressLinear Color="@GetPhaseColor(currentRun.Status)" Value="currentRun.Progress.PercentComplete" Striped="@isRunning" Size="Size.Large" />
                    <MudText Typo="Typo.body2">@currentRun.Progress.Message</MudText>
                    @if (currentRun.Progress.CompletedItems is not null && currentRun.Progress.TotalItems is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@currentRun.Progress.CompletedItems of @currentRun.Progress.TotalItems</MudText>
                    }
                </MudStack>
            }

            @if (progressLog.Count > 0)
            {
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="@($"Activity Log ({progressLog.Count} events)")">
                        <MudList T="string" Dense="true" Style="max-height: 200px; overflow-y: auto;">
                            @foreach (string entry in progressLog.AsEnumerable().Reverse().Take(15))
                            {
                                <MudListItem T="string">@entry</MudListItem>
                            }
                        </MudList>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Static Report</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="5">
                    <MudTextField T="string" Label="Report Output" @bind-Value="reportOutputDirectory" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField T="string" Label="Report Assets" @bind-Value="reportAssetsDirectory" Immediate="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@(!CanGenerateReport)" OnClick="GenerateReportAsync">Generate</MudButton>
                </MudItem>
            </MudGrid>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private const int PollDelayMilliseconds = 750;
    private RequestComparisonDefaults defaults = CreateEmptyDefaults();
    private IReadOnlyList<ContractProfileOption> availableProfileOptions = Array.Empty<ContractProfileOption>();
    private ContractProfileOption? selectedProfileOption;
    private string selectedPresetId = string.Empty;
    private string requestDirectory = string.Empty;
    private IReadOnlyList<string> sourceFiles = Array.Empty<string>();
    private string requestSourceDescription = string.Empty;
    private string endpointA = string.Empty;
    private string endpointB = string.Empty;
    private string timeoutSeconds = "30";
    private string maxConcurrency = "4";
    private string modelName = "Auto";
    private string contractProfileId = string.Empty;
    private string contentTypeOverride = string.Empty;
    private string maxDifferences = "100";
    private string ignoreRules = string.Empty;
    private string smartIgnoreRules = string.Empty;
    private string maskRules = string.Empty;
    private string commonHeaders = string.Empty;
    private string endpointAHeaders = string.Empty;
    private string endpointBHeaders = string.Empty;
    private string reportOutputDirectory = string.Empty;
    private string reportAssetsDirectory = string.Empty;
    private bool ignoreCollectionOrder;
    private bool ignoreStringCase;
    private bool ignoreTrailingWhitespace;
    private bool treatNullAndEmptyCollectionsEqual;
    private bool ignoreXmlNamespaces = true;
    private bool isBusy;
    private bool isRunning;
    private string? errorMessage;
    private string? successMessage;
    private ComparisonRun? currentRun;
    private readonly List<string> progressLog = new List<string>();

    [Parameter]
    public EventCallback<RunId> RunSelected { get; set; }

    [Parameter]
    public EventCallback<ComparisonRun> RunChanged { get; set; }

    private bool CanStartComparison => !isBusy && !isRunning;

    private bool CanCancel => currentRun is not null && isRunning && !isBusy;

    private bool CanGenerateReport => currentRun?.Status == RunStatus.Completed
        && !isBusy
        && !string.IsNullOrWhiteSpace(reportOutputDirectory);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            defaults = await DataSource.LoadDefaultsAsync();
            RefreshAvailableProfiles(clearInvalidSelection: false);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task HandlePresetChangedAsync(string value)
    {
        selectedPresetId = value ?? string.Empty;
        RequestComparisonPresetOption? preset = defaults.Presets.FirstOrDefault(candidate =>
            string.Equals(candidate.PresetId, selectedPresetId, StringComparison.OrdinalIgnoreCase));
        if (preset is null)
        {
            return;
        }

        sourceFiles = Array.Empty<string>();
        requestDirectory = preset.RequestDirectory;
        requestSourceDescription = $"Selected example preset: {preset.Label}";
        endpointA = preset.EndpointA.ToString();
        endpointB = preset.EndpointB.ToString();
        modelName = preset.ModelName;
        contractProfileId = preset.ContractProfileId ?? string.Empty;
        ApplyComparisonOptions(preset.ComparisonOptions);
        contentTypeOverride = preset.RequestExecutionOptions.ContentTypeOverride ?? string.Empty;
        RefreshAvailableProfiles(clearInvalidSelection: false);
        await Task.CompletedTask;
    }

    private Task HandleModelChangedAsync(string value)
    {
        modelName = string.IsNullOrWhiteSpace(value) ? "Auto" : value.Trim();
        RefreshAvailableProfiles(clearInvalidSelection: true);
        return Task.CompletedTask;
    }

    private Task HandleProfileChangedAsync(string value)
    {
        contractProfileId = value?.Trim() ?? string.Empty;
        RefreshSelectedProfile();
        ApplyProfileEndpointSuggestions();
        return Task.CompletedTask;
    }

    private void HandleEndpointAChanged(string value) => endpointA = value?.Trim() ?? string.Empty;

    private void HandleEndpointBChanged(string value) => endpointB = value?.Trim() ?? string.Empty;
    private void HandleRequestDirectoryChanged(string value)
    {
        selectedPresetId = string.Empty;
        requestDirectory = value;
        sourceFiles = Array.Empty<string>();
        requestSourceDescription = string.IsNullOrWhiteSpace(value) ? string.Empty : $"Selected request folder: {value}";
    }

    private async Task PickRequestDirectoryAsync()
    {
        string? selectedDirectory = await SourcePicker.PickRequestDirectoryAsync();
        if (string.IsNullOrWhiteSpace(selectedDirectory))
        {
            return;
        }

        selectedPresetId = string.Empty;
        requestDirectory = selectedDirectory;
        sourceFiles = Array.Empty<string>();
        requestSourceDescription = $"Selected request folder: {selectedDirectory}";
    }

    private async Task PickRequestFilesAsync()
    {
        IReadOnlyList<string> selectedFiles = await SourcePicker.PickRequestFilesAsync();
        if (selectedFiles.Count == 0)
        {
            return;
        }

        selectedPresetId = string.Empty;
        sourceFiles = selectedFiles;
        requestDirectory = GetCommonSourceDirectory(selectedFiles);
        requestSourceDescription = $"Selected {selectedFiles.Count} request files from {requestDirectory}";
    }

    private async Task StartWorkflowAsync()
    {
        try
        {
            isBusy = true;
            errorMessage = null;
            successMessage = null;
            progressLog.Clear();

            RequestComparisonRunRequest request = BuildRequest();
            currentRun = await DataSource.CreateRunFromDirectoryAsync(request);
            RecordProgress(currentRun);
            await NotifyRunChangedAsync(currentRun);

            bool started = await DataSource.StartRunAsync(currentRun.Id);
            if (!started)
            {
                errorMessage = "Run is already active.";
                return;
            }

            isRunning = true;
            await PollUntilTerminalAsync(currentRun.Id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
            isRunning = currentRun is not null && DataSource.IsRunning(currentRun.Id);
        }
    }

    private async Task CancelRunAsync()
    {
        if (currentRun is null)
        {
            return;
        }

        try
        {
            errorMessage = null;
            successMessage = null;
            currentRun = await DataSource.CancelRunAsync(currentRun.Id);
            RecordProgress(currentRun);
            isRunning = false;
            await NotifyRunChangedAsync(currentRun);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task GenerateReportAsync()
    {
        if (currentRun is null)
        {
            return;
        }

        try
        {
            isBusy = true;
            errorMessage = null;
            successMessage = null;
            StaticReportBundleWriteResult result = await DataSource
                .GenerateReportAsync(currentRun.Id, reportOutputDirectory, string.IsNullOrWhiteSpace(reportAssetsDirectory) ? null : reportAssetsDirectory);
            successMessage = $"Report written to {result.OutputDirectory}";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PollUntilTerminalAsync(RunId runId)
    {
        while (true)
        {
            await Task.Delay(PollDelayMilliseconds);
            currentRun = await DataSource.LoadRunAsync(runId);
            RecordProgress(currentRun);
            await NotifyRunChangedAsync(currentRun);
            await InvokeAsync(StateHasChanged);

            if (currentRun.IsTerminal)
            {
                isRunning = false;
                return;
            }
        }
    }

    private async Task NotifyRunChangedAsync(ComparisonRun run)
    {
        await RunSelected.InvokeAsync(run.Id);
        await RunChanged.InvokeAsync(run);
    }

    private RequestComparisonRunRequest BuildRequest()
    {
        if (!Uri.TryCreate(endpointA, UriKind.Absolute, out Uri? endpointAUri))
        {
            throw new InvalidOperationException("Endpoint A must be an absolute URL.");
        }

        if (!Uri.TryCreate(endpointB, UriKind.Absolute, out Uri? endpointBUri))
        {
            throw new InvalidOperationException("Endpoint B must be an absolute URL.");
        }

        int timeout = ParsePositiveInt(timeoutSeconds, "Timeout seconds");
        int concurrency = ParsePositiveInt(maxConcurrency, "Concurrency");
        int maxDifferenceCount = ParsePositiveInt(maxDifferences, "Max differences");

        ComparisonOptions comparisonOptions = new ComparisonOptions(
            ignoreCollectionOrder,
            ignoreStringCase,
            ignoreTrailingWhitespace,
            treatNullAndEmptyCollectionsEqual,
            ignoreXmlNamespaces,
            maxDifferenceCount,
            RunWorkflowRuleParser.ParseIgnoreRules(ignoreRules),
            RunWorkflowRuleParser.ParseSmartIgnoreRules(smartIgnoreRules),
            RunWorkflowRuleParser.ParseMaskRules(maskRules));
        RequestExecutionOptions executionOptions = new RequestExecutionOptions(contentTypeOverride);

        return new RequestComparisonRunRequest(
            requestDirectory,
            endpointAUri,
            endpointBUri,
            TimeSpan.FromSeconds(timeout),
            concurrency,
            modelName,
            comparisonOptions,
            executionOptions,
            string.IsNullOrWhiteSpace(contractProfileId) ? null : new ContractProfileSelection(contractProfileId),
            commonHeaders: ParseHeaders(commonHeaders),
            endpointAHeaders: ParseHeaders(endpointAHeaders),
            endpointBHeaders: ParseHeaders(endpointBHeaders),
            endpointALabel: ResolveEndpointLabel(endpointA),
            endpointBLabel: ResolveEndpointLabel(endpointB),
            sourceFiles: sourceFiles.Count == 0 ? null : sourceFiles);
    }

    private void ApplyComparisonOptions(ComparisonOptions options)
    {
        ignoreCollectionOrder = options.IgnoreCollectionOrder;
        ignoreStringCase = options.IgnoreStringCase;
        ignoreTrailingWhitespace = options.IgnoreTrailingWhitespaceAtEnd;
        treatNullAndEmptyCollectionsEqual = options.TreatNullAndEmptyCollectionsAsEqual;
        ignoreXmlNamespaces = options.IgnoreXmlNamespaces;
        maxDifferences = options.MaxDifferences.ToString();
        ignoreRules = FormatIgnoreRules(options.IgnoreRules);
        smartIgnoreRules = FormatSmartIgnoreRules(options.SmartIgnoreRules);
        maskRules = FormatMaskRules(options.MaskRules);
    }

    private void RefreshAvailableProfiles(bool clearInvalidSelection)
    {
        availableProfileOptions = defaults.ContractProfiles
            .Where(profile => string.Equals(profile.ResponseModelName, modelName, StringComparison.Ordinal))
            .ToArray();
        RefreshSelectedProfile();

        if (clearInvalidSelection && !string.IsNullOrWhiteSpace(contractProfileId) && selectedProfileOption is null)
        {
            contractProfileId = string.Empty;
            RefreshSelectedProfile();
        }
    }

    private void RefreshSelectedProfile()
    {
        selectedProfileOption = availableProfileOptions.FirstOrDefault(profile =>
            string.Equals(profile.ProfileId, contractProfileId, StringComparison.OrdinalIgnoreCase));
    }

    private void ApplyProfileEndpointSuggestions()
    {
        if (selectedProfileOption is null)
        {
            return;
        }

        EndpointOption? suggestedEndpointA = ResolveEndpoint(selectedProfileOption.EndpointASuggestedEndpointId);
        EndpointOption? suggestedEndpointB = ResolveEndpoint(selectedProfileOption.EndpointBSuggestedEndpointId);
        if (suggestedEndpointA is not null)
        {
            endpointA = suggestedEndpointA.Url.ToString();
        }

        if (suggestedEndpointB is not null)
        {
            endpointB = suggestedEndpointB.Url.ToString();
        }
    }

    private EndpointOption? ResolveEndpoint(string? endpointId) =>
        string.IsNullOrWhiteSpace(endpointId)
            ? null
            : defaults.Endpoints.FirstOrDefault(endpoint => string.Equals(endpoint.EndpointId, endpointId, StringComparison.OrdinalIgnoreCase));

    private string? ResolveEndpointLabel(string endpointUrl) =>
        defaults.Endpoints.FirstOrDefault(endpoint => string.Equals(endpoint.Url.ToString(), endpointUrl, StringComparison.OrdinalIgnoreCase))?.Label;

    private Task<IEnumerable<string>> SearchModelNamesAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(FilterOptions(new[] { "Auto" }.Concat(defaults.ResponseModels.Select(model => model.ModelName)), value));

    private Task<IEnumerable<string>> SearchProfileIdsAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(FilterOptions(availableProfileOptions.Select(profile => profile.ProfileId), value));

    private Task<IEnumerable<string>> SearchEndpointUrlsAsync(string value, CancellationToken cancellationToken)
    {
        IEnumerable<string> matches = defaults.Endpoints
            .Where(endpoint => MatchesSearch(endpoint.Label, value)
                || MatchesSearch(endpoint.EndpointId, value)
                || MatchesSearch(endpoint.Url.ToString(), value))
            .Select(endpoint => endpoint.Url.ToString());

        return Task.FromResult(matches);
    }

    private static IEnumerable<string> FilterOptions(IEnumerable<string> options, string search) =>
        options
            .Where(option => MatchesSearch(option, search))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(option => option, StringComparer.OrdinalIgnoreCase);

    private static bool MatchesSearch(string value, string search) =>
        string.IsNullOrWhiteSpace(search) || value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static bool HasProfileDefaultComparisonRules(ContractProfileOption? profile) =>
        profile?.DefaultComparisonRules.HasDefaults == true;

    private static IReadOnlyList<string> GetProfileDefaultRuleSummary(ComparisonRuleDefaults defaults)
    {
        List<string> summaries = new List<string>();
        if (defaults.IgnoreCollectionOrder)
        {
            summaries.Add("Ignore collection order");
        }

        if (defaults.IgnoreStringCase)
        {
            summaries.Add("Ignore string case");
        }

        if (defaults.IgnoreTrailingWhitespaceAtEnd)
        {
            summaries.Add("Ignore trailing whitespace");
        }

        if (defaults.TreatNullAndEmptyCollectionsAsEqual)
        {
            summaries.Add("Null and empty collections equal");
        }

        if (defaults.IgnoreXmlNamespaces)
        {
            summaries.Add("Ignore XML namespaces");
        }

        if (defaults.IgnoreRules.Count > 0)
        {
            summaries.Add($"Ignore paths: {defaults.IgnoreRules.Count}");
        }

        if (defaults.SmartIgnoreRules.Count > 0)
        {
            summaries.Add($"Smart ignores: {defaults.SmartIgnoreRules.Count}");
        }

        if (defaults.MaskRules.Count > 0)
        {
            summaries.Add($"Masks: {defaults.MaskRules.Count}");
        }

        return summaries;
    }
    private static string FormatIgnoreRules(IReadOnlyList<IgnoreRuleDefinition> rules) =>
        string.Join(Environment.NewLine, rules.Select(rule => rule.PropertyPath));

    private static string FormatSmartIgnoreRules(IReadOnlyList<SmartIgnoreRuleDefinition> rules) =>
        string.Join(Environment.NewLine, rules.Select(rule => $"{rule.Kind}={rule.Value}"));

    private static string FormatMaskRules(IReadOnlyList<MaskRuleDefinition> rules) =>
        string.Join(Environment.NewLine, rules.Select(FormatMaskRule));

    private static string FormatMaskRule(MaskRuleDefinition rule)
    {
        List<string> segments = new List<string> { rule.PropertyPath };
        if (rule.PreserveLastCharacters > 0)
        {
            segments.Add($"preserveLast={rule.PreserveLastCharacters}");
        }

        if (!string.Equals(rule.MaskCharacter, "*", StringComparison.Ordinal))
        {
            segments.Add($"mask={rule.MaskCharacter}");
        }

        return string.Join("|", segments);
    }
    private void RecordProgress(ComparisonRun run)
    {
        string entry = $"{DateTimeOffset.Now:HH:mm:ss} {run.Status}: {run.Progress.Message}";
        if (progressLog.Count == 0 || !string.Equals(progressLog[^1], entry, StringComparison.Ordinal))
        {
            progressLog.Add(entry);
        }
    }

    private static string GetCommonSourceDirectory(IReadOnlyList<string> filePaths)
    {
        string? commonDirectory = null;
        foreach (string filePath in filePaths)
        {
            string? directory = Path.GetDirectoryName(Path.GetFullPath(filePath));
            if (string.IsNullOrWhiteSpace(directory))
            {
                continue;
            }

            commonDirectory = commonDirectory is null ? directory : GetCommonDirectory(commonDirectory, directory);
        }

        return commonDirectory ?? string.Empty;
    }

    private static string GetCommonDirectory(string firstDirectory, string secondDirectory)
    {
        string[] firstParts = firstDirectory.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        string[] secondParts = secondDirectory.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        int sharedLength = 0;
        while (sharedLength < firstParts.Length
            && sharedLength < secondParts.Length
            && string.Equals(firstParts[sharedLength], secondParts[sharedLength], StringComparison.OrdinalIgnoreCase))
        {
            sharedLength++;
        }

        return sharedLength == 0
            ? Path.GetPathRoot(firstDirectory) ?? firstDirectory
            : string.Join(Path.DirectorySeparatorChar, firstParts.Take(sharedLength));
    }

    private static string GetPhaseIcon(RunStatus status) =>
        status switch
        {
            RunStatus.Completed => Icons.Material.Filled.CheckCircle,
            RunStatus.Failed => Icons.Material.Filled.Error,
            RunStatus.Cancelled => Icons.Material.Filled.Cancel,
            RunStatus.Executing => Icons.Material.Filled.PlayArrow,
            RunStatus.Comparing => Icons.Material.Filled.CompareArrows,
            RunStatus.Analyzing => Icons.Material.Filled.Analytics,
            _ => Icons.Material.Filled.Sync,
        };

    private static Color GetPhaseColor(RunStatus status) =>
        status switch
        {
            RunStatus.Completed => Color.Success,
            RunStatus.Failed => Color.Error,
            RunStatus.Cancelled => Color.Warning,
            _ => Color.Primary,
        };

    private static int ParsePositiveInt(string value, string label)
    {
        if (!int.TryParse(value, out int parsed) || parsed <= 0)
        {
            throw new InvalidOperationException($"{label} must be a positive whole number.");
        }

        return parsed;
    }

    private static IReadOnlyDictionary<string, string> ParseHeaders(string text)
    {
        Dictionary<string, string> headers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (string rawLine in text.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            string line = rawLine.Trim();
            if (line.Length == 0)
            {
                continue;
            }

            int separatorIndex = line.IndexOf(':', StringComparison.Ordinal);
            if (separatorIndex <= 0)
            {
                throw new InvalidOperationException($"Header '{line}' must use Name: Value format.");
            }

            headers[line[..separatorIndex].Trim()] = line[(separatorIndex + 1)..].Trim();
        }

        return headers;
    }

    private static RequestComparisonDefaults CreateEmptyDefaults() =>
        new RequestComparisonDefaults(
            Array.Empty<ResponseModelOption>(),
            Array.Empty<ContractProfileOption>(),
            Array.Empty<EndpointOption>(),
            Array.Empty<RequestComparisonPresetOption>());
