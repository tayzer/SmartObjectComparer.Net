    private void ApplyProfileEndpointSuggestions()
    {
        if (selectedProfileOption is null)
        {
            return;
        }

        EndpointOption? suggestedEndpointA = ResolveEndpoint(selectedProfileOption.EndpointASuggestedEndpointId);
        EndpointOption? suggestedEndpointB = ResolveEndpoint(selectedProfileOption.EndpointBSuggestedEndpointId);
        if (suggestedEndpointA is not null)
        {
            endpointA = suggestedEndpointA.Url.ToString();
            endpointAHeaders = FormatHeaders(suggestedEndpointA.DefaultHeaders);
        }

        if (suggestedEndpointB is not null)
        {
            endpointB = suggestedEndpointB.Url.ToString();
            endpointBHeaders = FormatHeaders(suggestedEndpointB.DefaultHeaders);
        }
    }

    private EndpointOption? ResolveEndpoint(string? endpointId) =>
        string.IsNullOrWhiteSpace(endpointId)
            ? null
            : defaults.Endpoints.FirstOrDefault(endpoint => string.Equals(endpoint.EndpointId, endpointId, StringComparison.OrdinalIgnoreCase));

    private string? ResolveEndpointLabel(string endpointUrl) =>
        defaults.Endpoints.FirstOrDefault(endpoint => string.Equals(endpoint.Url.ToString(), endpointUrl, StringComparison.OrdinalIgnoreCase))?.Label;

    private Task<IEnumerable<string>> SearchModelNamesAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(FilterOptions(new[] { "Auto" }.Concat(defaults.ResponseModels.Select(model => model.ModelName)), value));

    private Task<IEnumerable<string>> SearchProfileIdsAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(FilterOptions(availableProfileOptions.Select(profile => profile.ProfileId), value));

    private Task<IEnumerable<string>> SearchEndpointUrlsAsync(string value, CancellationToken cancellationToken)
    {
        IEnumerable<string> matches = defaults.Endpoints
            .Where(endpoint => MatchesSearch(endpoint.Label, value)
                || MatchesSearch(endpoint.EndpointId, value)
                || MatchesSearch(endpoint.Url.ToString(), value))
            .Select(endpoint => endpoint.Url.ToString());

        return Task.FromResult(matches);
    }

    private static IEnumerable<string> FilterOptions(IEnumerable<string> options, string search) =>
        options
            .Where(option => MatchesSearch(option, search))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(option => option, StringComparer.OrdinalIgnoreCase);

    private static bool MatchesSearch(string value, string search) =>
        string.IsNullOrWhiteSpace(search) || value.Contains(search, StringComparison.OrdinalIgnoreCase);

