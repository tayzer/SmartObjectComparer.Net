@using ParityBench.NET.Application.Plugins
@using ParityBench.NET.Application.Profiles
@using ParityBench.NET.Application.Secrets
@using ParityBench.NET.Domain.Runs
@using ParityBench.NET.Domain.Runs.Retention
@using ParityBench.PluginSdk.Configuration
@using ParityBench.PluginSdk.Profiles

@inject IRunProfileStore ProfileStore
@inject IPluginMetadataProvider PluginMetadata
@inject PluginProfileBootstrapper ProfileBootstrapper
@inject ISecretStore SecretStore
@inject ISnackbar Snackbar

@* Saved run profiles: list, create from an installed plugin's template, edit its
   endpoints and step configuration, and save. Secret fields are written to the
   secret store on save and stored in the profile as references only. *@

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6">Run profiles</MudText>
                    <MudMenu Icon="@Icons.Material.Filled.Add" Dense="true" AriaLabel="Create profile from template">
                        @if (templates.Count == 0)
                        {
                            <MudMenuItem Disabled="true">No plugin templates installed</MudMenuItem>
                        }
                        @foreach (TemplateOption option in templates)
                        {
                            <MudMenuItem OnClick="@(() => CreateFromTemplateAsync(option))">@option.Label</MudMenuItem>
                        }
                    </MudMenu>
                </MudStack>

                @if (profiles.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No saved profiles yet.</MudText>
                }
                <MudList T="string" SelectedValue="@editing?.Id" Dense="true">
                    @foreach (RunProfile profile in profiles)
                    {
                        <MudListItem T="string" Value="@profile.Id" OnClick="@(() => EditAsync(profile))">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@profile.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@profile.ComparisonId</MudText>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        @if (editing is null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Select a profile to edit, or create one from a plugin template.
                </MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">Edit profile</MudText>
                    <MudTextField T="string" Label="Id" Value="@editing.Id" ReadOnly="true" />
                    <MudTextField T="string" Label="Display name" @bind-Value="editDisplayName" />
                    <MudSelect T="string" Label="Plugin version"
                               Value="@editPluginVersion"
                               ValueChanged="OnPluginVersionChangedAsync"
                               HelperText="@PluginVersionHelperText">
                        <MudSelectItem T="string" Value="@string.Empty">@LatestOptionLabel</MudSelectItem>
                        @foreach (VersionOption option in editPluginVersions)
                        {
                            <MudSelectItem T="string" Value="@option.Version">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" Label="Endpoint A URL" @bind-Value="editEndpointA" />
                    <MudTextField T="string" Label="Endpoint B URL" @bind-Value="editEndpointB" />
                    <MudTextField T="string" Label="Request directory" @bind-Value="editRequestDirectory" />
                    <MudExpansionPanels>
                        <MudExpansionPanel Text="Performance calibration">
                            <MudStack Spacing="2" Class="pt-2">
                                <MudTextField T="string" Label="Mapping workers"
                                              @bind-Value="editMappingConcurrency"
                                              Immediate="true"
                                              HelperText="Blank uses Auto. Mapping reads artifacts and creates comparison models." />
                                <MudTextField T="string" Label="Compare workers"
                                              @bind-Value="editComparisonConcurrency"
                                              Immediate="true"
                                              HelperText="Blank uses Auto. Comparison workers run model preparation and pair comparison." />
                                <MudTextField T="string" Label="Focused-content workers"
                                              @bind-Value="editFocusedContentConcurrency"
                                              Immediate="true"
                                              HelperText="Blank uses Auto. Focused workers read, prune, and persist focused artifacts." />
                                <MudSelect T="WorkerGcMode" Label="Worker GC mode" @bind-Value="editWorkerGcMode">
                                    @foreach (WorkerGcMode mode in Enum.GetValues<WorkerGcMode>())
                                    {
                                        <MudSelectItem T="WorkerGcMode" Value="@mode">@GcModeLabel(mode)</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (editWorkerGcMode == WorkerGcMode.ServerFixed)
                                {
                                    <MudTextField T="string" Label="Server GC heaps"
                                                  @bind-Value="editServerGcHeapCount"
                                                  Immediate="true"
                                                  HelperText="Positive heap count selected by machine calibration." />
                                }
                                @if (HasCalibrationMachineMismatch)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        This profile was calibrated on different hardware. Explicit settings remain unchanged; rerun local calibration before trusting the old recommendation.
                                    </MudAlert>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Auto uses at most eight workers per post-HTTP stage. Results record actual workers and GC mode.
                                </MudText>
                            </MudStack>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                    <MudSelect T="string" Label="Response retention"
                               Value="@editRetentionMode"
                               ValueChanged="@(value => editRetentionMode = value ?? string.Empty)"
                               HelperText="@RetentionHelperText">
                        <MudSelectItem T="string" Value="@string.Empty">Use configured default</MudSelectItem>
                        @foreach (RetentionMode mode in RetentionModePresentation.Modes)
                        {
                            <MudSelectItem T="string" Value="@mode.ToString()">@RetentionModePresentation.Label(mode)</MudSelectItem>
                        }
                    </MudSelect>

                    @foreach (PluginConfigurationSchema schema in editSchemas)
                    {
                        <MudDivider />
                        <PluginConfigurationForm Schema="schema"
                                                 Values="@StepValues(schema.OwnerId)"
                                                 ValuesChanged="StateHasChanged" />
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveAsync">Save</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="DeleteAsync">Delete</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private readonly List<RunProfile> profiles = new List<RunProfile>();
    private readonly List<TemplateOption> templates = new List<TemplateOption>();

    private RunProfile? editing;
    private string editDisplayName = string.Empty;
    private string editEndpointA = string.Empty;
    private string editEndpointB = string.Empty;
    private string editRequestDirectory = string.Empty;
    private string editComparisonConcurrency = string.Empty;
    private string editMappingConcurrency = string.Empty;
    private string editFocusedContentConcurrency = string.Empty;
    private WorkerGcMode editWorkerGcMode;
    private string editServerGcHeapCount = string.Empty;
    private string? editCalibrationMachineFingerprint;

    /// <summary>
    /// The version the profile pins, or empty for "highest installed". Empty is the
    /// default: a profile that names no version keeps working across plugin upgrades.
    /// </summary>
    private string editPluginVersion = string.Empty;

    private readonly List<VersionOption> editPluginVersions = new List<VersionOption>();
    private string? latestInstalledVersion;

    /// <summary>
    /// The retention mode runs from this profile start with, empty for the configured
    /// default. It is a default, not a lock — the run workflow's picker can override
    /// it for a single run.
    /// </summary>
    private string editRetentionMode = string.Empty;
    private List<PluginConfigurationSchema> editSchemas = new List<PluginConfigurationSchema>();
    private Dictionary<string, Dictionary<string, string>> editStepConfiguration = new Dictionary<string, Dictionary<string, string>>(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Bumped by the catalog panel after it rescans, so this panel picks up a plugin
    /// that was installed or rebuilt while the app was running.
    /// </summary>
    [Parameter] public int CatalogVersion { get; set; }

    private int loadedCatalogVersion = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (CatalogVersion == loadedCatalogVersion)
        {
            return;
        }

        loadedCatalogVersion = CatalogVersion;

        // Seed profiles from installed plugin templates so a freshly installed plugin
        // shows a ready-made profile here without any manual step. This runs on a
        // rescan too, since a plugin discovered just now has never been seeded.
        await ProfileBootstrapper.EnsureTemplateProfilesAsync().ConfigureAwait(true);
        await ReloadProfilesAsync().ConfigureAwait(true);
        await LoadTemplatesAsync().ConfigureAwait(true);

        // A profile being edited is left alone: its fields may hold unsaved work,
        // including a secret that has not reached the secret store yet. Only the
        // schemas driving the form and the installed versions are re-read, in case
        // the plugin changed them.
        if (editing is not null)
        {
            await LoadPluginVersionsAsync(editing.PluginId).ConfigureAwait(true);
            editSchemas = await LoadSchemasFor(editing.PluginId, SelectedPluginVersion).ConfigureAwait(true);
        }
    }

    private async Task ReloadProfilesAsync()
    {
        profiles.Clear();
        profiles.AddRange(await ProfileStore.ListAsync().ConfigureAwait(true));
    }

    private async Task LoadTemplatesAsync()
    {
        templates.Clear();
        PluginCatalogView catalog = await PluginMetadata.GetCatalogAsync().ConfigureAwait(true);
        foreach (InstalledPluginMetadata plugin in catalog.Plugins)
        {
            foreach (PluginProfileTemplate template in plugin.ProfileTemplates)
            {
                templates.Add(new TemplateOption(plugin, template, $"{plugin.DisplayName}: {template.DisplayName}"));
            }
        }
    }

    private async Task CreateFromTemplateAsync(TemplateOption option)
    {
        // Materialise the template into a real, editable profile. Endpoints come
        // from the named environment when the template selects one.
        PluginEnvironment? environment = option.Plugin.Environments
            .FirstOrDefault(candidate => string.Equals(candidate.Name, option.Template.EnvironmentName, StringComparison.OrdinalIgnoreCase));
        Uri endpointA = environment?.EndpointA ?? new Uri("https://endpoint-a.example");
        Uri endpointB = environment?.EndpointB ?? new Uri("https://endpoint-b.example");

        string id = UniqueProfileId(option.Template.TemplateId);
        RunProfile profile = new RunProfile(
            id,
            option.Template.DisplayName,
            option.Plugin.PluginId,
            option.Template.ComparisonId,
            endpointA,
            endpointB,
            // Unpinned, so the profile follows the highest installed version of the
            // plugin. The version picker below is how a specific build is pinned.
            pluginVersion: null,
            environmentName: option.Template.EnvironmentName,
            enabledStepIds: option.Template.EnabledStepIds,
            stepConfiguration: option.Template.StepConfiguration, 
            requestDirectory: option.Template.RequestDirectory,
            endpointAHeaders: environment?.EndpointAHeaders,
            endpointBHeaders: environment?.EndpointBHeaders);

        await EditAsync(profile).ConfigureAwait(true);
    }

    private async Task EditAsync(RunProfile profile)
    {
        editing = profile;
        editDisplayName = profile.DisplayName;
        editEndpointA = profile.EndpointA.ToString();
        editEndpointB = profile.EndpointB.ToString();
        editRequestDirectory = profile.RequestDirectory ?? string.Empty;
        editComparisonConcurrency = profile.LargeRun.ComparisonConcurrency?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        editMappingConcurrency = profile.LargeRun.MappingConcurrency?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        editFocusedContentConcurrency = profile.LargeRun.FocusedContentConcurrency?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        editWorkerGcMode = profile.LargeRun.WorkerGcMode;
        editServerGcHeapCount = profile.LargeRun.ServerGcHeapCount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        editCalibrationMachineFingerprint = profile.LargeRun.PerformanceCalibrationMachineFingerprint;
        editPluginVersion = profile.PluginVersion ?? string.Empty;
        editRetentionMode = profile.RetentionModeOverride?.ToString() ?? string.Empty;
        editStepConfiguration = profile.StepConfiguration.ToDictionary(
            entry => entry.Key,
            entry => new Dictionary<string, string>(entry.Value, StringComparer.OrdinalIgnoreCase),
            StringComparer.OrdinalIgnoreCase);
        await LoadPluginVersionsAsync(profile.PluginId).ConfigureAwait(true);
        editSchemas = await LoadSchemasFor(profile.PluginId, SelectedPluginVersion).ConfigureAwait(true);
    }

    private async Task<List<PluginConfigurationSchema>> LoadSchemasFor(string pluginId, string? version)
    {
        InstalledPluginMetadata? plugin = await PluginMetadata
            .GetPluginAsync(pluginId, version)
            .ConfigureAwait(true);
        return plugin?.ConfigurationSchemas.ToList() ?? new List<PluginConfigurationSchema>();
    }

    /// <summary>
    /// Lists the versions of this plugin that are installed, plus the version the
    /// profile pins when that is no longer installed — so a profile left pointing at
    /// a removed build shows what it names and can be moved off it, rather than the
    /// pin silently disappearing from the picker.
    /// </summary>
    private async Task LoadPluginVersionsAsync(string pluginId)
    {
        PluginCatalogView catalog = await PluginMetadata.GetCatalogAsync().ConfigureAwait(true);
        List<InstalledPluginMetadata> installed = catalog.Plugins
            .Where(plugin => string.Equals(plugin.PluginId, pluginId, StringComparison.OrdinalIgnoreCase))
            .ToList();

        latestInstalledVersion = installed.FirstOrDefault(plugin => plugin.IsActive)?.Version;

        editPluginVersions.Clear();
        editPluginVersions.AddRange(installed.Select(plugin => new VersionOption(
            plugin.Version,
            plugin.IsActive ? $"{plugin.Version} (latest)" : plugin.Version)));

        if (!string.IsNullOrWhiteSpace(editPluginVersion)
            && !installed.Any(plugin => string.Equals(plugin.Version, editPluginVersion, StringComparison.OrdinalIgnoreCase)))
        {
            editPluginVersions.Add(new VersionOption(editPluginVersion, $"{editPluginVersion} (not installed)"));
        }
    }

    private async Task OnPluginVersionChangedAsync(string? version)
    {
        editPluginVersion = version ?? string.Empty;
        if (editing is not null)
        {
            // The picked version decides which package's configuration schema drives
            // the form, so the fields below follow the selection.
            editSchemas = await LoadSchemasFor(editing.PluginId, SelectedPluginVersion).ConfigureAwait(true);
        }
    }

    private string? SelectedPluginVersion =>
        string.IsNullOrWhiteSpace(editPluginVersion) ? null : editPluginVersion;

    private string LatestOptionLabel =>
        latestInstalledVersion is null ? "Latest installed" : $"Latest installed ({latestInstalledVersion})";

    private string RetentionHelperText =>
        RetentionModePresentation.Parse(editRetentionMode) is null
            ? "Runs from this profile follow the app-wide ParityBench:Retention:Mode setting."
            : "Runs from this profile start with this mode; the run workflow can still override it.";

    private string PluginVersionHelperText =>
        SelectedPluginVersion is null
            ? "Follows the highest installed version, so plugin upgrades apply automatically."
            : "Pinned: this profile fails to run if the version is not installed.";

    private Dictionary<string, string> StepValues(string stepId)
    {
        if (!editStepConfiguration.TryGetValue(stepId, out Dictionary<string, string>? values))
        {
            values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            editStepConfiguration[stepId] = values;
        }

        return values;
    }

    private async Task SaveAsync()
    {
        if (editing is null)
        {
            return;
        }

        if (!Uri.TryCreate(editEndpointA, UriKind.Absolute, out Uri? endpointA)
            || !Uri.TryCreate(editEndpointB, UriKind.Absolute, out Uri? endpointB))
        {
            Snackbar.Add("Both endpoint URLs must be absolute.", Severity.Error);
            return;
        }

        if (!TryParseOptionalWorkers(editMappingConcurrency, "Mapping workers", out int? mappingConcurrency)
            || !TryParseOptionalWorkers(editComparisonConcurrency, "Compare workers", out int? comparisonConcurrency)
            || !TryParseOptionalWorkers(editFocusedContentConcurrency, "Focused-content workers", out int? focusedContentConcurrency))
        {
            return;
        }

        int? serverGcHeapCount = null;
        if (editWorkerGcMode == WorkerGcMode.ServerFixed
            && !TryParseRequiredWorkers(editServerGcHeapCount, "Server GC heaps", out serverGcHeapCount))
        {
            return;
        }

        IReadOnlyDictionary<string, IReadOnlyDictionary<string, string>> persistedConfiguration =
            await PersistSecretsAsync(editing, editSchemas, editStepConfiguration).ConfigureAwait(true);

        RunProfile updated = new RunProfile(
            editing.Id,
            editDisplayName,
            editing.PluginId,
            editing.ComparisonId,
            endpointA,
            endpointB,
            pluginVersion: SelectedPluginVersion,
            environmentName: editing.EnvironmentName,
            enabledStepIds: editing.EnabledStepIds,
            stepConfiguration: persistedConfiguration,
            comparison: editing.Comparison,
            requestDirectory: string.IsNullOrWhiteSpace(editRequestDirectory) ? null : editRequestDirectory,
            largeRun: new LargeRunOptions(
                largeRunThreshold: editing.LargeRun.LargeRunThreshold,
                chunkSize: editing.LargeRun.ChunkSize,
                detailPageSize: editing.LargeRun.DetailPageSize,
                comparisonConcurrency: comparisonConcurrency,
                progressUpdateItemInterval: editing.LargeRun.ProgressUpdateItemInterval,
                progressUpdateMillisecondsInterval: editing.LargeRun.ProgressUpdateMillisecondsInterval,
                mappingConcurrency: mappingConcurrency,
                focusedContentConcurrency: focusedContentConcurrency,
                workerGcMode: editWorkerGcMode,
                serverGcHeapCount: serverGcHeapCount,
                performanceCalibrationMachineFingerprint: HasExplicitPerformanceCalibration(
                    mappingConcurrency,
                    comparisonConcurrency,
                    focusedContentConcurrency,
                    editWorkerGcMode)
                    ? CurrentMachineFingerprint()
                    : null),
            retentionModeOverride: RetentionModePresentation.Parse(editRetentionMode),
            endpointAHeaders: editing.EndpointAHeaders,
            endpointBHeaders: editing.EndpointBHeaders);

        await ProfileStore.SaveAsync(updated).ConfigureAwait(true);
        await ReloadProfilesAsync().ConfigureAwait(true);
        editing = updated;
        Snackbar.Add($"Saved profile '{updated.DisplayName}'.", Severity.Success);
    }

    // For each Secret field with a freshly entered value, write it to the secret
    // store and replace it with a reference so the profile file never holds the value.
    private async Task<IReadOnlyDictionary<string, IReadOnlyDictionary<string, string>>> PersistSecretsAsync(
        RunProfile profile,
        IReadOnlyList<PluginConfigurationSchema> schemas,
        IReadOnlyDictionary<string, Dictionary<string, string>> stepConfiguration)
    {
        Dictionary<string, HashSet<string>> secretKeysByStep = schemas.ToDictionary(
            schema => schema.OwnerId,
            schema => schema.Fields.Where(field => field.Kind == PluginFieldKind.Secret).Select(field => field.Key).ToHashSet(StringComparer.OrdinalIgnoreCase),
            StringComparer.OrdinalIgnoreCase);

        Dictionary<string, IReadOnlyDictionary<string, string>> result = new Dictionary<string, IReadOnlyDictionary<string, string>>(StringComparer.OrdinalIgnoreCase);
        foreach ((string stepId, Dictionary<string, string> values) in stepConfiguration)
        {
            Dictionary<string, string> persisted = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            secretKeysByStep.TryGetValue(stepId, out HashSet<string>? secretKeys);

            foreach ((string key, string value) in values)
            {
                if (secretKeys?.Contains(key) == true
                    && !SecretReference.TryParse(value, out _)
                    && SecretStore.CanWrite)
                {
                    SecretReference reference = new SecretReference(profile.PluginId, $"{profile.Id}.{stepId}.{key}");
                    await SecretStore.SetAsync(reference, value).ConfigureAwait(true);
                    persisted[key] = reference.ToString();
                }
                else
                {
                    persisted[key] = value;
                }
            }

            result[stepId] = persisted;
        }

        return result;
    }

    private async Task DeleteAsync()
    {
        if (editing is null)
        {
            return;
        }

        await ProfileStore.DeleteAsync(editing.Id).ConfigureAwait(true);
        await ReloadProfilesAsync().ConfigureAwait(true);
        editing = null;
        editPluginVersion = string.Empty;
        editPluginVersions.Clear();
        editRetentionMode = string.Empty;
        editComparisonConcurrency = string.Empty;
        editMappingConcurrency = string.Empty;
        editFocusedContentConcurrency = string.Empty;
        editWorkerGcMode = WorkerGcMode.Auto;
        editServerGcHeapCount = string.Empty;
        editCalibrationMachineFingerprint = null;
        Snackbar.Add("Profile deleted.", Severity.Info);
    }

    private bool HasCalibrationMachineMismatch =>
        !string.IsNullOrWhiteSpace(editCalibrationMachineFingerprint)
        && !string.Equals(editCalibrationMachineFingerprint, CurrentMachineFingerprint(), StringComparison.Ordinal);

    private static bool HasExplicitPerformanceCalibration(
        int? mappingConcurrency,
        int? comparisonConcurrency,
        int? focusedContentConcurrency,
        WorkerGcMode gcMode) =>
        mappingConcurrency is not null
        || comparisonConcurrency is not null
        || focusedContentConcurrency is not null
        || gcMode != WorkerGcMode.Auto;

    private static string CurrentMachineFingerprint()
    {
        long availableMemory = GC.GetGCMemoryInfo().TotalAvailableMemoryBytes;
        long memoryGiB = (long)Math.Round(availableMemory / 1024d / 1024d / 1024d, MidpointRounding.AwayFromZero);
        string identity = $"{System.Runtime.InteropServices.RuntimeInformation.OSArchitecture}|{Environment.ProcessorCount}|{memoryGiB}";
        byte[] digest = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(identity));
        return Convert.ToHexString(digest.AsSpan(0, 12)).ToLowerInvariant();
    }

    private string UniqueProfileId(string templateId)
    {
        string baseId = templateId;
        string candidate = baseId;
        int suffix = 2;
        while (profiles.Any(profile => string.Equals(profile.Id, candidate, StringComparison.OrdinalIgnoreCase)))
        {
            candidate = $"{baseId}-{suffix++}";
        }

        return candidate;
    }

    private sealed record TemplateOption(InstalledPluginMetadata Plugin, PluginProfileTemplate Template, string Label);

    private sealed record VersionOption(string Version, string Label);

    private bool TryParseOptionalWorkers(string value, string label, out int? parsed)
    {
        parsed = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        return TryParseRequiredWorkers(value, label, out parsed);
    }

    private bool TryParseRequiredWorkers(string value, string label, out int? parsed)
    {
        parsed = null;
        if (!int.TryParse(value, out int count) || count <= 0)
        {
            Snackbar.Add($"{label} must be a positive whole number.", Severity.Error);
            return false;
        }

        parsed = count;
        return true;
    }

    private static string GcModeLabel(WorkerGcMode mode) => mode switch
    {
        WorkerGcMode.Auto => "Auto",
        WorkerGcMode.Workstation => "Workstation",
        WorkerGcMode.ServerAdaptive => "Server adaptive (DATAS)",
        WorkerGcMode.ServerFixed => "Server fixed heaps",
        _ => mode.ToString(),
    };
}
