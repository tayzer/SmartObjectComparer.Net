@using System.Globalization
@using System.Text.Json
@using System.Xml
@using System.Xml.Linq
@using ParityBench.NET.Domain.Baselines
@using ParityBench.NET.Domain.Reports
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IRunResultsViewDataSource DataSource
@inject IAcceptedDifferenceUseCases AcceptedDifferences
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<style>
    .v1-report-header { border-left: 4px solid var(--mud-palette-primary); }
    .v1-report-stat { min-width: 8rem; border: 1px solid var(--mud-palette-lines-default); }
    .v1-code { font-family: var(--pb-font-mono); font-size: .825rem; white-space: pre-wrap; overflow-wrap: anywhere; }
    .v1-diff-a { background: var(--pb-diff-a-background); border-left: 3px solid var(--pb-diff-a-border); }
    .v1-diff-b { background: var(--pb-diff-b-background); border-left: 3px solid var(--pb-diff-b-border); }
    .v1-property-tree-container { max-height: 34rem; overflow: auto; border-right: 1px solid var(--mud-palette-lines-default); }
    .v1-property-detail-panel { max-height: 34rem; overflow: auto; }
    .v1-property-detail-header { position: sticky; top: 0; z-index: 2; background: var(--mud-palette-surface); margin: 0 -1rem; padding: 1rem 1rem .75rem; }
    .v1-tree-node-content { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: .5rem; padding: .25rem .5rem; border-radius: 4px; cursor: pointer; }
    .v1-tree-node-content.selected { background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .v1-tree-node-label { min-width: 0; display: inline-flex; align-items: center; gap: .35rem; overflow-wrap: anywhere; }
    .v1-diff-card { border: 1px solid var(--mud-palette-lines-default); }
    .v1-structured-tree { max-height: min(65vh, 44rem); overflow: auto; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; background: var(--mud-palette-surface); }
    .v1-structured-grid-header, .v1-structured-diff-row { display: grid; grid-template-columns: minmax(14rem, 1.4fr) minmax(8rem, 1fr) minmax(8rem, 1fr) minmax(11rem, auto); align-items: stretch; }
    .v1-structured-grid-header { position: sticky; top: 0; z-index: 3; min-height: 2rem; background: var(--mud-palette-background-grey); border-bottom: 1px solid var(--mud-palette-lines-default); color: var(--mud-palette-text-secondary); font-size: .72rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }
    .v1-structured-grid-header > div, .v1-structured-diff-cell { min-width: 0; padding: .38rem .55rem; border-right: 1px solid var(--mud-palette-lines-default); }
    .v1-structured-grid-header > div:last-child, .v1-structured-diff-cell:last-child { border-right: 0; }
    .v1-structured-node { border: 0; }
    .v1-structured-node-header { min-height: 1.95rem; width: 100%; justify-content: flex-start; border-bottom: 1px solid var(--mud-palette-lines-default); border-radius: 0; background: var(--mud-palette-surface); cursor: pointer; text-align: left; text-transform: none; }
    .v1-structured-node-header:hover { background: var(--mud-palette-action-default-hover); }
    .v1-structured-node-toggle { margin: 0 .25rem 0 0; padding: 0; width: 1.4rem; height: 1.4rem; }
    .v1-structured-node-name { font-weight: 600; line-height: 1.2; }
    .v1-structured-count { margin-left: .5rem; color: var(--mud-palette-error); font-size: .72rem; font-weight: 600; }
    .v1-structured-node-children { display: block; }
    .v1-structured-diff-row { min-height: 2.3rem; border-bottom: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .v1-structured-diff-row:hover { background: var(--mud-palette-action-default-hover); }
    .v1-structured-diff-prop { display: flex; align-items: center; font-family: var(--pb-font-mono); font-size: .8rem; font-weight: 600; overflow-wrap: anywhere; }
    .v1-structured-diff-value { display: flex; align-items: center; font-family: var(--pb-font-mono); font-size: .8rem; white-space: pre-wrap; overflow-wrap: anywhere; }
    .v1-structured-diff-actions { display: flex; align-items: center; gap: .25rem; flex-wrap: wrap; }
    .v1-structured-null { color: var(--mud-palette-text-secondary); font-style: italic; }
    .v1-structured-limit { padding: .4rem .65rem; border-bottom: 1px solid var(--mud-palette-lines-default); color: var(--mud-palette-text-secondary); font-size: .75rem; }

    @@media (max-width: 850px) {
        .v1-structured-grid-header { display: none; }
        .v1-structured-diff-row { grid-template-columns: 1fr 1fr; padding: .35rem 0; }
        .v1-structured-diff-cell { border-right: 0; }
        .v1-structured-diff-prop, .v1-structured-diff-actions { grid-column: 1 / -1; }
        .v1-structured-diff-value::before { content: attr(data-label); display: block; margin-right: .4rem; color: var(--mud-palette-text-secondary); font-family: inherit; font-size: .68rem; font-weight: 700; text-transform: uppercase; }
    }
</style>

@if (RunId is null)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">Select a run</MudText>
}
else if (isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
        <MudProgressCircular Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">Loading comparison report...</MudText>
    </MudStack>
}
else if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
}
else if (run is not null && (!run.IsTerminal || summary is null))
{
    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudChip T="string" Color="@GetRunStatusColor(run.Status)" Variant="Variant.Filled">@run.Status</MudChip>
                <MudText Typo="Typo.subtitle2">Run @run.Id.Value</MudText>
            </MudStack>
            <MudProgressLinear Color="@GetRunStatusColor(run.Status)" Value="run.Progress.PercentComplete" Striped="@(!run.IsTerminal)" Size="Size.Large" />
            <MudText Typo="Typo.body2">@GetRunStatusMessage(run)</MudText>
            @if (run.Progress.CompletedItems is not null && run.Progress.TotalItems is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@run.Progress.CompletedItems of @run.Progress.TotalItems</MudText>
            }
        </MudStack>
    </MudPaper>
}
else if (run is not null)
{
    <MudStack Spacing="4">
        <MudPaper Outlined="true" Class="pa-4 v1-report-header">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="flex-wrap" Spacing="2">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h5">@(metadata?.ReportTitle ?? "Comparison Report")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Run @run.Id.Value - @run.Status - updated @FormatDate(run.UpdatedAt)</MudText>
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudText Typo="Typo.body2"><strong>@LabelA:</strong> @EndpointA</MudText>
                        <MudText Typo="Typo.body2"><strong>@LabelB:</strong> @EndpointB</MudText>
                    </MudStack>
                </MudStack>
                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                    @if (Baseline is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Icon="@Icons.Material.Filled.Inventory2">@Baseline.ModeLabel</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@ModelName</MudChip>
                    @if (metadata?.Elapsed is not null)
                    {
                        <MudChip T="string" Size="Size.Small">@FormatDuration(metadata.Elapsed.Value)</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">Generated @FormatDate(metadata?.GeneratedAt ?? DateTimeOffset.UtcNow)</MudChip>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (Baseline is { Mode: BaselineRunMode.BaselineVsLive })
        {
            @* A baseline is compared across time and often across environments, so the
               report has to say so: an unexplained difference here is not automatically
               a code regression. *@
            <MudAlert Severity="@(Baseline.HasProvenanceWarning ? Severity.Warning : Severity.Info)" Variant="Variant.Outlined">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2">
                        <strong>Baseline vs Live.</strong>
                        Expected results come from baseline <strong>@Baseline.DisplayName @Baseline.DisplayVersion</strong>,
                        captured @FormatDate(Baseline.CapturedAt ?? DateTimeOffset.MinValue)@(string.IsNullOrWhiteSpace(Baseline.CaptureEndpoint) ? string.Empty : $" from {Baseline.CaptureEndpoint}")@(string.IsNullOrWhiteSpace(Baseline.CaptureEnvironment) ? string.Empty : $" in {Baseline.CaptureEnvironment}").
                        The live side was called during this run.
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Data, configuration and external dependencies may have changed since the capture.
                        A difference here is not automatically a software regression.
                    </MudText>
                    @if (Baseline.PluginVersionChanged)
                    {
                        <MudText Typo="Typo.body2">
                            Mapping plugin differs: baseline captured with <strong>@Baseline.CapturePluginVersion</strong>, this run used <strong>@Baseline.LivePluginVersion</strong>.
                        </MudText>
                    }
                    @if (Baseline.EnvironmentChanged)
                    {
                        <MudText Typo="Typo.body2">
                            Environment differs: baseline captured in <strong>@Baseline.CaptureEnvironment</strong>, this run ran against <strong>@Baseline.LiveEnvironment</strong>.
                        </MudText>
                    }
                    <MudText Typo="Typo.caption">
                        @Baseline.ScenarioCount captured scenario@(Baseline.ScenarioCount == 1 ? string.Empty : "s") · comparison @Baseline.CapturePluginId/@Baseline.CaptureComparisonId · captured by run @Baseline.CapturedFromRunId
                    </MudText>
                </MudStack>
            </MudAlert>
        }
        else if (Baseline is { Mode: BaselineRunMode.CaptureBaseline })
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                <MudText Typo="Typo.body2">
                    <strong>Baseline capture.</strong>
                    This run recorded @Baseline.ScenarioCount scenario@(Baseline.ScenarioCount == 1 ? string.Empty : "s") into baseline
                    <strong>@Baseline.DisplayName @Baseline.DisplayVersion</strong>. Nothing was compared — one endpoint was called and its
                    results stored for a later Baseline vs Live run.
                </MudText>
            </MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            @Stat("Total", summary?.TotalPairs ?? analysis?.TotalPairs ?? 0, Color.Default)
            @Stat("Equal", summary?.EqualPairs ?? 0, Color.Success)
            @Stat("Different", summary?.DifferentPairs ?? analysis?.DifferentPairs ?? 0, Color.Warning)
            @Stat("Errors", summary?.ErrorPairs ?? analysis?.ErrorPairs ?? 0, Color.Error)
            @Stat("Status", summary?.StatusCodeMismatchPairs ?? 0, Color.Info)
            @Stat("Non-success", summary?.BothNonSuccessPairs ?? 0, Color.Secondary)
            @Stat("Total Diffs", analysis?.TotalDifferences ?? 0, Color.Primary)
        </MudStack>

        @if (metadata?.ExecutionMetrics is not null)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Row="true" Spacing="1" Class="flex-wrap" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Request Comparison Timings</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Wall clock: @FormatDuration(metadata.ExecutionMetrics.TotalDuration)</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">Request worker time (aggregate): @FormatDuration(metadata.ExecutionMetrics.RequestExecutionDuration)</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">Compare worker time (aggregate): @FormatDuration(metadata.ExecutionMetrics.ComparisonDuration)</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">Finalization wall time: @FormatDuration(metadata.ExecutionMetrics.FinalizationDuration)</MudChip>
                    <MudChip T="string" Size="Size.Small">Requests: @metadata.ExecutionMetrics.RequestCount</MudChip>
                    <MudChip T="string" Size="Size.Small">HTTP workers: @metadata.ExecutionMetrics.MaxConcurrency</MudChip>
                    <MudChip T="string" Size="Size.Small">Compare workers: @metadata.ExecutionMetrics.ComparisonConcurrency</MudChip>
                    <MudChip T="string" Size="Size.Small">@FormatRate(metadata.ExecutionMetrics.RequestCount, metadata.ExecutionMetrics.TotalDuration) requests/s</MudChip>
                    <MudChip T="string" Size="Size.Small">@FormatRate(metadata.ExecutionMetrics.RequestCount, metadata.ExecutionMetrics.ComparisonDuration) compare pairs/worker-s</MudChip>
                    <MudChip T="string" Size="Size.Small">@FormatMiBRate(metadata.ExecutionMetrics.ResponseBytesWritten, metadata.ExecutionMetrics.TotalDuration) MiB/s written</MudChip>
                    @if (metadata.ExecutionMetrics.CompareSubPhases is { } phases)
                    {
                        <MudChip T="string" Size="Size.Small">Normalize: @FormatDuration(phases.NormalizeDuration)</MudChip>
                        <MudChip T="string" Size="Size.Small">Canonical persistence: @FormatDuration(phases.PersistCanonicalDuration)</MudChip>
                        <MudChip T="string" Size="Size.Small">Diff/body read: @FormatDuration(phases.DiffDuration)</MudChip>
                        <MudChip T="string" Size="Size.Small">Focused content: @FormatDuration(phases.FocusedContentDuration)</MudChip>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (analysis is not null)
        {
            <MudPaper Outlined="true" Class="pa-0">
                <MudTabs Elevation="0" PanelClass="pa-4" ActivePanelIndex="@analysisTabIndex" ActivePanelIndexChanged="OnAnalysisTabChangedAsync">
                    <MudTabPanel Text="Run Details" Icon="@Icons.Material.Filled.Assessment">
                        <MudGrid>
                            <MudItem xs="12" md="5">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">Difference Categories</MudText>
                                <MudTable T="StaticReportDifferenceCategorySummary" Items="analysis.Categories" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent><MudTh>Category</MudTh><MudTh>Occurrences</MudTh><MudTh>Pairs</MudTh></HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Category">@context.DisplayName</MudTd>
                                        <MudTd DataLabel="Occurrences">@context.OccurrenceCount</MudTd>
                                        <MudTd DataLabel="Pairs">@context.AffectedPairCount</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                            <MudItem xs="12" md="7">
                                <MudText Typo="Typo.subtitle1" Class="mb-2">Top Affected Objects</MudText>
                                <MudTable T="StaticReportAffectedObjectSummary" Items="analysis.TopAffectedObjects" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent><MudTh>Request</MudTh><MudTh>Category</MudTh><MudTh>Diffs</MudTh><MudTh></MudTh></HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Request">@context.Identifier</MudTd>
                                        <MudTd DataLabel="Category"><MudChip T="string" Size="Size.Small">@context.Category</MudChip></MudTd>
                                        <MudTd DataLabel="Diffs">@context.DifferenceCount</MudTd>
                                        <MudTd><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SelectAffectedObjectAsync(context.Identifier))">View</MudButton></MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    <MudTabPanel Text="All Differences" Icon="@Icons.Material.Filled.AccountTree">
                        @if (isLoadingDifferenceIndex)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        }
                        else if (!string.IsNullOrWhiteSpace(differenceIndexErrorMessage))
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@differenceIndexErrorMessage</MudAlert>
                        }
                        else if (differenceIndex is null)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="LoadDifferenceIndexAsync">Load All Differences</MudButton>
                        }
                        else if (differenceIndex.Properties.Count == 0)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No structured domain-model differences were found.</MudAlert>
                        }
                        else
                        {
                            <MudGrid Spacing="0">
                                <MudItem xs="12" md="4">
                                    <div class="v1-property-tree-container">
                                        <MudStack Class="pa-3" Spacing="2">
                                            <MudTextField T="string" @bind-Value="allDifferencesFilter" Placeholder="Filter by path or pair..." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="300" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@FilteredDifferenceProperties.Count.ToString("N0", CultureInfo.InvariantCulture) properties</MudText>
                                                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                                                    <MudTooltip Text="Expand all differences">
                                                        <MudIconButton Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" OnClick="ExpandAllDifferenceNodes" aria-label="Expand all differences" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="Collapse all differences">
                                                        <MudIconButton Icon="@Icons.Material.Filled.UnfoldLess" Size="Size.Small" OnClick="CollapseAllDifferenceNodes" aria-label="Collapse all differences" />
                                                    </MudTooltip>
                                                </MudButtonGroup>
                                            </MudStack>
                                            @if (!string.IsNullOrWhiteSpace(differenceTreeInfoMessage))
                                            {
                                                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">@differenceTreeInfoMessage</MudAlert>
                                            }
                                        </MudStack>
                                        @if (DifferenceTreeNodes.Count == 0)
                                        {
                                            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="ma-3">No differences match the current filter.</MudAlert>
                                        }
                                        else
                                        {
                                            <MudTreeView T="string" Items="DifferenceTreeItems" Hover="true" Dense="true" Class="pa-2">
                                                <ItemTemplate>
                                                    @{
                                                        var node = context as PropertyTreeNode;
                                                    }
                                                    @if (node is not null)
                                                    {
                                                        <MudTreeViewItem T="string" @bind-Expanded="@context.Expanded" Items="@context.Children" Value="@context.Value" OnClick="@(() => SelectPropertyTreeNode(context))">
                                                            <BodyContent Context="_">
                                                                <div class="v1-tree-node-content @(node.FullPath == selectedPropertyPath ? "selected" : string.Empty)">
                                                                    <span class="v1-tree-node-label">
                                                                        <MudIcon Icon="@(node.IsLeaf ? Icons.Material.Filled.Circle : Icons.Material.Filled.Folder)" Size="Size.Small" />
                                                                        <span>@node.Name</span>
                                                                    </span>
                                                                    <MudStack Row="true" Spacing="1">
                                                                        <MudTooltip Text="Affected pairs"><MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">@node.AffectedPairCount.ToString("N0", CultureInfo.InvariantCulture)</MudChip></MudTooltip>
                                                                        <MudTooltip Text="Total differences"><MudChip T="string" Size="Size.Small" Color="@(node.IsLeaf ? Color.Info : Color.Default)" Variant="Variant.Text">@node.DifferenceCount.ToString("N0", CultureInfo.InvariantCulture)</MudChip></MudTooltip>
                                                                    </MudStack>
                                                                </div>
                                                            </BodyContent>
                                                        </MudTreeViewItem>
                                                    }
                                                </ItemTemplate>
                                            </MudTreeView>
                                        }
                                    </div>
                                </MudItem>
                                <MudItem xs="12" md="8">
                                    <div class="v1-property-detail-panel" id="all-differences-property-detail-panel">
                                        @if (SelectedPropertySummary is null)
                                        {
                                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8" Style="min-height: 20rem;">
                                                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" />
                                                <MudText Typo="Typo.h6" Color="Color.Secondary">Select a Property</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Click a leaf in the tree to see affected pairs.</MudText>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudStack Spacing="3" Class="px-4 pb-4">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap v1-property-detail-header">
                                                    <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" /><code>@SelectedPropertySummary.NormalizedPath</code></MudText>
                                                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@SelectedPropertySummary.AffectedPairCount.ToString("N0", CultureInfo.InvariantCulture) pairs</MudChip>
                                                        <MudChip T="string" Size="Size.Small">@SelectedPropertySummary.OccurrenceCount.ToString("N0", CultureInfo.InvariantCulture) diffs</MudChip>
                                                        <MudChip T="string" Size="Size.Small">@SelectedPropertySummary.Category</MudChip>
                                                    </MudStack>
                                                </MudStack>
                                                @foreach (var affectedPair in SelectedPropertySummary.AffectedPairs)
                                                {
                                                    <MudPaper Outlined="true" Class="pa-3 v1-diff-card">
                                                        <MudStack Spacing="2">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="1">
                                                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Color="Color.Secondary" />
                                                                <MudLink Color="Color.Primary" Style="cursor: pointer; font-weight: 600;" OnClick="@(() => SelectPairByRelativePathAsync(affectedPair.RelativePath))">@affectedPair.RelativePath</MudLink>
                                                                <MudChip T="string" Size="Size.Small" Color="@GetOutcomeColor(affectedPair.Outcome)" Variant="Variant.Outlined">@affectedPair.Outcome</MudChip>
                                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@affectedPair.OccurrenceCount diffs</MudChip>
                                                                @if (affectedPair.StatusCodeA.HasValue) { <MudChip T="string" Size="Size.Small" Color="@GetStatusCodeColor(affectedPair.StatusCodeA.Value)" Variant="Variant.Outlined">@LabelA: @affectedPair.StatusCodeA</MudChip> }
                                                                @if (affectedPair.StatusCodeB.HasValue) { <MudChip T="string" Size="Size.Small" Color="@GetStatusCodeColor(affectedPair.StatusCodeB.Value)" Variant="Variant.Outlined">@LabelB: @affectedPair.StatusCodeB</MudChip> }
                                                                <MudTooltip Text="Open request pair">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Primary" OnClick="@(() => SelectPairByRelativePathAsync(affectedPair.RelativePath))" aria-label="Open request pair" />
                                                                </MudTooltip>
                                                            </MudStack>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary"><code>@affectedPair.PropertyPath</code></MudText>
                                                            <MudGrid Spacing="2">
                                                                <MudItem xs="12" sm="6"><div class="v1-diff-a pa-2"><MudText Typo="Typo.caption" Color="Color.Success">@LabelA</MudText><div class="v1-code">@(affectedPair.ValueA ?? "null")</div></div></MudItem>
                                                                <MudItem xs="12" sm="6"><div class="v1-diff-b pa-2"><MudText Typo="Typo.caption" Color="Color.Error">@LabelB</MudText><div class="v1-code">@(affectedPair.ValueB ?? "null")</div></div></MudItem>
                                                            </MudGrid>
                                                        </MudStack>
                                                    </MudPaper>
                                                }
                                            </MudStack>
                                        }
                                    </div>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="Options" Icon="@Icons.Material.Filled.Tune">
                        <AcceptedDifferenceProfilesPanel OnProfilesChanged="ReloadAcceptedMatchesAsync" />
                        <MudDivider Class="my-3" />
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudChip T="string" Size="Size.Small">@(run.Options.Comparison.IncludeAllDifferences ? "All differences" : $"Max differences {run.Options.Comparison.MaxDifferences}")</MudChip>
                            <MudChip T="string" Size="Size.Small">Ignore namespaces @FormatBool(run.Options.Comparison.IgnoreXmlNamespaces)</MudChip>
                            <MudChip T="string" Size="Size.Small">Ignore order @FormatBool(run.Options.Comparison.IgnoreCollectionOrder)</MudChip>
                            <MudChip T="string" Size="Size.Small">Ignore case @FormatBool(run.Options.Comparison.IgnoreStringCase)</MudChip>
                            <MudChip T="string" Size="Size.Small">Ignore rules @run.Options.Comparison.IgnoreRules.Count</MudChip>
                            <MudChip T="string" Size="Size.Small">Smart ignores @run.Options.Comparison.SmartIgnoreRules.Count</MudChip>
                            <MudChip T="string" Size="Size.Small">Masks @run.Options.Comparison.MaskRules.Count</MudChip>
                        </MudStack>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        }
        <MudPaper Outlined="true" Class="pa-0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-3 flex-wrap" Spacing="2">
                <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.CompareArrows" Class="mr-2" />@LabelA vs @LabelB Comparison Results</MudText>
                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@(resultsCollapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)" OnClick="() => resultsCollapsed = !resultsCollapsed">@(resultsCollapsed ? "Expand" : "Collapse")</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportJsonAsync">JSON</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsvAsync">CSV</MudButton>
                </MudStack>
            </MudStack>
            @if (!resultsCollapsed)
            {
                <MudDivider />
                <div class="pa-3">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap mb-3">
                        <MudTextField T="string" Value="@searchFilter" ValueChanged="OnSearchChangedAsync" Placeholder="Search by request..." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="300" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width: 16rem;" />
                        <MudSelect T="string" Value="@statusFilter" ValueChanged="OnStatusFilterChangedAsync" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 12rem;">
                            <MudSelectItem T="string" Value="@AllFilter">All</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Equal")">Equal</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Different")">Different</MudSelectItem>
                            <MudSelectItem T="string" Value="@("StatusCodeMismatch")">Status mismatch</MudSelectItem>
                            <MudSelectItem T="string" Value="@("BothNonSuccess")">Non-success</MudSelectItem>
                            <MudSelectItem T="string" Value="@("ExecutionFailed")">Errors</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Value="@categoryFilter" ValueChanged="OnCategoryFilterChanged" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 13rem;">
                            <MudSelectItem T="string" Value="@AllFilter">All Categories</MudSelectItem>
                            @foreach (var category in AvailableCategories)
                            {
                                <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="int" Value="@pageSize" ValueChanged="OnPageSizeChangedAsync" Label="Rows" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 7rem;">
                            @foreach (var option in PageSizeOptions)
                            {
                                <MudSelectItem T="int" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>

                    @if (detailPage is null)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                    else
                    {
                        <MudTable T="RequestPairResult" Items="VisiblePageItems" Dense="true" Hover="true" Elevation="0" RowClassFunc="GetPairRowClass" OnRowClick="OnPairRowClickedAsync">
                            <HeaderContent><MudTh>Status</MudTh><MudTh>Request</MudTh><MudTh>HTTP Status</MudTh><MudTh>Differences</MudTh><MudTh>Category</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Status"><MudIcon Icon="@GetOutcomeIcon(context.Outcome)" Color="@GetOutcomeColor(context.Outcome)" /></MudTd>
                                <MudTd DataLabel="Request"><MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SelectPairAsync(context))">@context.RelativePath</MudButton></MudTd>
                                <MudTd DataLabel="HTTP Status">
                                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                        @if (context.ResponseA is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="@GetStatusCodeColor(context.ResponseA.StatusCode)" Variant="Variant.Outlined">@LabelA: @context.ResponseA.StatusCode</MudChip>
                                        }
                                        @if (context.ResponseB is not null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="@GetStatusCodeColor(context.ResponseB.StatusCode)" Variant="Variant.Outlined">@LabelB: @context.ResponseB.StatusCode</MudChip>
                                        }
                                    </MudStack>
                                </MudTd>
                                <MudTd DataLabel="Differences"><MudChip T="string" Size="Size.Small" Color="@GetDifferenceChipColor(context)">@(context.Outcome == RequestPairOutcome.ExecutionFailed ? "-" : context.DifferenceCount)</MudChip></MudTd>
                                <MudTd DataLabel="Category"><MudChip T="string" Size="Size.Small">@GetPairCategory(context)</MudChip></MudTd>
                                <MudTd><MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => SelectPairAsync(context))">View</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3 flex-wrap">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Showing @(detailPage.TotalCount == 0 ? 0 : detailPage.Offset + 1)-@(detailPage.Offset + detailPage.Items.Count) of @detailPage.TotalCount</MudText>
                            <MudStack Row="true" Spacing="1"><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(detailOffset == 0)" OnClick="PreviousPageAsync">Previous</MudButton><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(!detailPage.HasMore)" OnClick="NextPageAsync">Next</MudButton></MudStack>
                        </MudStack>
                    }
                </div>
            }
        </MudPaper>

        @if (selectedPair is not null)
        {
            <MudPaper Outlined="true" Class="pa-0" id="report-detailed-differences-section">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-3 flex-wrap" Spacing="2">
                    <MudStack Spacing="0"><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Compare" Class="mr-2" />Detailed Comparison</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@selectedPair.RelativePath</MudText></MudStack>
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        <MudSelect T="DetailViewMode" Value="@detailViewMode" ValueChanged="OnDetailViewModeChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 10rem;">
                            <MudSelectItem T="DetailViewMode" Value="DetailViewMode.Structured">Structured</MudSelectItem>
                            @if (selectedPair.RawTextDifferences.Count > 0) { <MudSelectItem T="DetailViewMode" Value="DetailViewMode.Raw">Raw Differences</MudSelectItem> }
                            @if (selectedPair.HasFocusedRawContent) { <MudSelectItem T="DetailViewMode" Value="DetailViewMode.Focused">Focused</MudSelectItem> }
                            @if (HasArtifactContent(selectedPair)) { <MudSelectItem T="DetailViewMode" Value="DetailViewMode.Full">Full</MudSelectItem> }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportSelectedPairJsonAsync">Export This Result</MudButton>
                    </MudStack>
                </MudStack>
                <MudDivider />
                <div class="pa-4">
                    @if (!string.IsNullOrWhiteSpace(selectedPair.ErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@selectedPair.ErrorMessage</MudAlert>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mt-2">Check the request payload, endpoint configuration, content type, and whether an error page was returned instead of the expected response.</MudAlert>
                    }
                    else if (detailViewMode == DetailViewMode.Raw)
                    {
                        @if (selectedPair.ResponseA is not null && selectedPair.ResponseB is not null)
                        {
                            <MudAlert Severity="@(selectedPair.Outcome == RequestPairOutcome.StatusCodeMismatch ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Class="mb-3">HTTP Status Codes: @LabelA @selectedPair.ResponseA.StatusCode, @LabelB @selectedPair.ResponseB.StatusCode</MudAlert>
                        }
                        <MudTable T="StaticReportRawTextDifference" Items="selectedPair.RawTextDifferences" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent><MudTh>Type</MudTh><MudTh>Line</MudTh><MudTh>@LabelA</MudTh><MudTh>@LabelB</MudTh></HeaderContent>
                            <RowTemplate><MudTd>@context.Type</MudTd><MudTd>@FormatRawLine(context)</MudTd><MudTd Class="v1-code v1-diff-a">@(context.TextA ?? string.Empty)</MudTd><MudTd Class="v1-code v1-diff-b">@(context.TextB ?? string.Empty)</MudTd></RowTemplate>
                            <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
                        </MudTable>
                    }
                    else if (IsSideBySideRawContentView)
                    {
                        @if (isLoadingContent) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
                        else if (!string.IsNullOrWhiteSpace(contentErrorMessage)) { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@contentErrorMessage</MudAlert> }
                        else
                        {
                            <AlignedSideBySideDiff ContentA="@(contentA?.Content ?? string.Empty)"
                                                   ContentB="@(contentB?.Content ?? string.Empty)"
                                                   LabelA="@LabelA"
                                                   LabelB="@LabelB"
                                                   FileNameA="@(selectedPair.ResponseA?.Artifact.ArtifactId ?? selectedPair.RelativePath)"
                                                   FileNameB="@(selectedPair.ResponseB?.Artifact.ArtifactId ?? selectedPair.RelativePath)"
                                                   IsTruncatedA="@(contentA?.IsTruncated == true)"
                                                   IsTruncatedB="@(contentB?.IsTruncated == true)" />
                        }
                    }
                    else
                    {
                        <MudPaper Outlined="true" Class="pa-0">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-3 flex-wrap" Spacing="2">
                                <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.List" Class="mr-2" />Structured Differences <MudChip T="string" Size="Size.Small">@selectedPair.Differences.Count</MudChip></MudText>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => showAllDifferences = !showAllDifferences">@(showAllDifferences ? "Limit to 100 per branch" : "Show all differences")</MudButton>
                            </MudStack>
                            <MudDivider />
                            <div class="pa-4">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap mb-3">
                                    <MudTextField T="string" @bind-Value="structuredSearchFilter" Placeholder="Search differences..." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="300" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width: 16rem;" />
                                    <MudSwitch T="bool" @bind-Value="hideAcceptedDifferences" Color="Color.Primary" Label="Hide accepted / known bugs" />
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@GetTrackingCount(null) New</MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@GetTrackingCount(AcceptedDifferenceStatus.AcceptedDifference) Accepted</MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@GetTrackingCount(AcceptedDifferenceStatus.KnownBug) Known Bugs</MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@GetTrackingCount(AcceptedDifferenceStatus.FixedVerified) Fixed / Verified</MudChip>
                                </MudStack>
                                @{
                                    IReadOnlyList<StructuredDifferenceNode> structuredNodes = GetStructuredDifferenceTree(selectedPair);
                                }
                                @if (selectedPair.Differences.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Success" Variant="Variant.Text">@(selectedPair.OutcomeMessage ?? "No structured differences were recorded.")</MudAlert>
                                }
                                else if (structuredNodes.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Text">No differences match the current search.</MudAlert>
                                }
                                else
                                {
                                    structuredRenderedRowCount = 0;
                                    <div class="v1-structured-tree" role="treegrid" aria-label="Structured differences">
                                        <div class="v1-structured-grid-header" role="row">
                                            <div role="columnheader">Property</div>
                                            <div role="columnheader">@LabelA</div>
                                            <div role="columnheader">@LabelB</div>
                                            <div role="columnheader">Status / Actions</div>
                                        </div>
                                        @foreach (StructuredDifferenceNode node in structuredNodes)
                                        {
                                            @RenderStructuredDifferenceNode(node, 0)
                                        }
                                    </div>
                                    int structuredTotalCount = CountStructuredDifferences(structuredNodes);
                                    if (structuredRenderedRowCount < structuredTotalCount)
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">Showing @structuredRenderedRowCount.ToString("N0", CultureInfo.InvariantCulture) of @structuredTotalCount.ToString("N0", CultureInfo.InvariantCulture) differences. Refine your search to see the rest.</MudAlert>
                                    }
                                }
                            </div>
                        </MudPaper>
                    }
                </div>
            </MudPaper>
        }

        @if (editingAcceptedDifference is not null)
        {
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle2">Track Difference</MudText>
                    <MudText Typo="Typo.body2"><strong>Property:</strong> @editingAcceptedDifference.PropertyPath</MudText>
                    <MudSelect T="AcceptedDifferenceStatus" @bind-Value="acceptedDifferenceEditorStatus" Label="Classification" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@AcceptedDifferenceStatus.AcceptedDifference">Accepted Difference</MudSelectItem>
                        <MudSelectItem Value="@AcceptedDifferenceStatus.KnownBug">Known Bug</MudSelectItem>
                        <MudSelectItem Value="@AcceptedDifferenceStatus.FixedVerified">Fixed / Verified</MudSelectItem>
                    </MudSelect>
                    @if (acceptedDifferenceEditorStatus == AcceptedDifferenceStatus.KnownBug)
                    {
                        <MudTextField T="string" @bind-Value="acceptedDifferenceEditorTicket" Label="Ticket ID" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    }
                    <MudTextField T="string" @bind-Value="acceptedDifferenceEditorNotes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                    @if (!string.IsNullOrWhiteSpace(acceptedDifferenceErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@acceptedDifferenceErrorMessage</MudAlert>
                    }
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        <MudButton Variant="Variant.Text" OnClick="CloseAcceptedDifferenceEditor">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSaveAcceptedDifference)" OnClick="SaveAcceptedDifferenceAsync">Save</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
        @if (!string.IsNullOrWhiteSpace(downloadErrorMessage)) { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@downloadErrorMessage</MudAlert> }
    </MudStack>
}

@code {
    private const string AllFilter = "All";
    private const int StructuredGlobalRenderCap = 500;
    private static readonly int[] PageSizeOptions = { 25, 50, 100, 250 };
    private int structuredRenderedRowCount;
    private RunId? loadedRunId;
    private int loadedRefreshVersion = -1;
    private ComparisonRun? run;
    private RunResultSummary? summary;
    private StaticReportMetadata? metadata;
    private StaticReportAnalysisSnapshot? analysis;
    private StaticReportDifferenceIndex? differenceIndex;
    private RunDetailPage? detailPage;
    private RequestPairResult? selectedPair;
    private ArtifactContentPreview? contentA;
    private ArtifactContentPreview? contentB;
    private int detailOffset;
    private int pageSize = 25;
    private bool isLoading;
    private bool isLoadingContent;
    private bool showAllDifferences;
    private HashSet<string> collapsedStructuredGroups = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private bool resultsCollapsed;
    private bool isLoadingDifferenceIndex;
    private int analysisTabIndex;
    private string searchFilter = string.Empty;
    private string statusFilter = AllFilter;
    private string categoryFilter = AllFilter;
    private string structuredSearchFilter = string.Empty;
    private string allDifferencesFilter = string.Empty;
    private string? selectedPropertyPath;
    private string? errorMessage;
    private string? contentErrorMessage;
    private string? downloadErrorMessage;
    private string? differenceIndexErrorMessage;
    private string differenceTreeInfoMessage = string.Empty;
    private DetailViewMode detailViewMode = DetailViewMode.Structured;
    private Dictionary<string, AcceptedDifferenceProfile> acceptedDifferenceMatches = new Dictionary<string, AcceptedDifferenceProfile>(StringComparer.Ordinal);
    private bool hideAcceptedDifferences;
    private ComparisonDifference? editingAcceptedDifference;
    private AcceptedDifferenceStatus acceptedDifferenceEditorStatus = AcceptedDifferenceStatus.AcceptedDifference;
    private string acceptedDifferenceEditorNotes = string.Empty;
    private string acceptedDifferenceEditorTicket = string.Empty;
    private string? acceptedDifferenceErrorMessage;

    [Parameter] public RunId? RunId { get; set; }
    [Parameter] public int RefreshVersion { get; set; }

    private string LabelA => metadata?.EndpointALabel ?? run?.Options.EndpointA.Label ?? "Endpoint A";
    private string LabelB => metadata?.EndpointBLabel ?? run?.Options.EndpointB.Label ?? "Endpoint B";
    private string EndpointA => metadata?.EndpointA ?? run?.Options.EndpointA.Uri.ToString() ?? string.Empty;
    private string EndpointB => metadata?.EndpointB ?? run?.Options.EndpointB.Uri.ToString() ?? string.Empty;
    private string ModelName => metadata?.ModelName ?? run?.Options.ModelName ?? "Auto";
    private BaselineReportProvenance? Baseline => metadata?.Baseline;
    private IReadOnlyList<string> AvailableCategories => analysis?.AvailableCategories ?? Array.Empty<string>();
    private IReadOnlyList<RequestPairResult> VisiblePageItems => detailPage is null ? Array.Empty<RequestPairResult>() : detailPage.Items.Where(MatchesCategoryFilter).ToList();
    private IReadOnlyList<StaticReportPropertyDifferenceSummary> FilteredDifferenceProperties => GetFilteredDifferenceProperties();
    private StaticReportPropertyDifferenceSummary? SelectedPropertySummary => differenceIndex?.Properties.FirstOrDefault(property => string.Equals(property.NormalizedPath, selectedPropertyPath, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<PropertyTreeNode> DifferenceTreeNodes => BuildDifferenceTree(FilteredDifferenceProperties);
    private IReadOnlyList<TreeItemData<string>> DifferenceTreeItems => DifferenceTreeNodes.Cast<TreeItemData<string>>().ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (RunId is null || (RunId == loadedRunId && RefreshVersion == loadedRefreshVersion)) { return; }
        loadedRunId = RunId;
        loadedRefreshVersion = RefreshVersion;
        detailOffset = 0;
        await LoadRunAsync();
    }

    private async Task LoadRunAsync()
    {
        if (RunId is null) { return; }
        try
        {
            isLoading = true;
            errorMessage = null;
            selectedPair = null;
            differenceIndex = null;
            selectedPropertyPath = null;
            differenceIndexErrorMessage = null;
            contentA = null;
            contentB = null;
            RunId runId = RunId.Value;
            run = await DataSource.LoadRunAsync(runId);
            if (!run.IsTerminal)
            {
                summary = null;
                metadata = null;
                analysis = null;
                detailPage = null;
                return;
            }

            summary = await DataSource.LoadRunSummaryAsync(runId);
            if (summary is null)
            {
                metadata = null;
                analysis = null;
                detailPage = null;
                return;
            }

            metadata = await DataSource.LoadReportMetadataAsync(runId);
            analysis = await DataSource.LoadReportAnalysisAsync(runId);
            RestoreFiltersFromUrl();
            await LoadDetailPageAsync();
            if (detailPage?.Items.Count > 0) { await SelectPairAsync(detailPage.Items[0]); }
            await RestoreSelectionFromUrlAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            run = null; summary = null; metadata = null; analysis = null; differenceIndex = null; detailPage = null;
        }
        finally { isLoading = false; }
    }

    private async Task LoadDetailPageAsync()
    {
        if (RunId is null) { return; }
        RunId runId = RunId.Value;
        detailPage = await DataSource.LoadRunDetailsAsync(runId, new RunDetailQuery(detailOffset, pageSize, ParseStatusFilter(statusFilter), searchFilter));
        await ReloadAcceptedMatchesAsync();
    }


    private async Task OnAnalysisTabChangedAsync(int value)
    {
        analysisTabIndex = value;
        if (value == 1 && differenceIndex is null && !isLoadingDifferenceIndex)
        {
            await LoadDifferenceIndexAsync();
        }
    }

    private async Task LoadDifferenceIndexAsync()
    {
        if (RunId is null) { return; }
        try
        {
            isLoadingDifferenceIndex = true;
            differenceIndexErrorMessage = null;
            differenceIndex = await DataSource.LoadDifferenceIndexAsync(RunId.Value);
            selectedPropertyPath = differenceIndex.Properties.FirstOrDefault()?.NormalizedPath;
        }
        catch (Exception ex)
        {
            differenceIndexErrorMessage = ex.Message;
        }
        finally
        {
            isLoadingDifferenceIndex = false;
        }
    }
    private async Task OnSearchChangedAsync(string value) { searchFilter = value ?? string.Empty; detailOffset = 0; await LoadDetailPageAsync(); await PushViewStateToUrlAsync(); }
    private async Task OnStatusFilterChangedAsync(string value) { statusFilter = value ?? AllFilter; detailOffset = 0; await LoadDetailPageAsync(); await PushViewStateToUrlAsync(); }
    private async Task OnCategoryFilterChanged(string value) { categoryFilter = value ?? AllFilter; await PushViewStateToUrlAsync(); }
    private async Task OnPageSizeChangedAsync(int value) { pageSize = value; detailOffset = 0; await LoadDetailPageAsync(); }
    private async Task PreviousPageAsync() { detailOffset = Math.Max(0, detailOffset - pageSize); await LoadDetailPageAsync(); }
    private async Task NextPageAsync() { if (detailPage?.HasMore == true) { detailOffset += pageSize; await LoadDetailPageAsync(); } }

    private Task SelectAffectedObjectAsync(string identifier) => SelectPairByRelativePathAsync(identifier);

    private async Task SelectPairByRelativePathAsync(string relativePath)
    {
        searchFilter = relativePath;
        statusFilter = AllFilter;
        categoryFilter = AllFilter;
        detailOffset = 0;
        await LoadDetailPageAsync();
        RequestPairResult? pair = detailPage?.Items.FirstOrDefault(item => string.Equals(item.RelativePath, relativePath, StringComparison.OrdinalIgnoreCase))
            ?? detailPage?.Items.FirstOrDefault(item => item.RelativePath.Contains(relativePath, StringComparison.OrdinalIgnoreCase));
        if (pair is not null)
        {
            await SelectPairAsync(pair);
        }
    }
    private async Task SelectPairAsync(RequestPairResult pair)
    {
        selectedPair = pair;
        contentA = null; contentB = null; contentErrorMessage = null;
        detailViewMode = pair.RawTextDifferences.Count > 0
            ? DetailViewMode.Raw
            : DetailViewMode.Structured;
        structuredSearchFilter = string.Empty;
        showAllDifferences = false;
        collapsedStructuredGroups = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (detailViewMode is DetailViewMode.Full or DetailViewMode.Focused)
        {
            await LoadContentAsync();
        }

        await PushViewStateToUrlAsync();
        await ScrollToDetailAsync();
    }

    private Task OnPairRowClickedAsync(TableRowClickEventArgs<RequestPairResult> args) => args.Item is null ? Task.CompletedTask : SelectPairAsync(args.Item);

    private async Task OnDetailViewModeChangedAsync(DetailViewMode mode)
    {
        detailViewMode = mode;
        if (mode is DetailViewMode.Full or DetailViewMode.Focused)
        {
            contentA = null;
            contentB = null;
            await LoadContentAsync();
        }
    }

    private async Task LoadContentAsync()
    {
        if (selectedPair is null || isLoadingContent) { return; }
        isLoadingContent = true;
        contentErrorMessage = null;
        try
        {
            var artifactA = detailViewMode == DetailViewMode.Focused
                ? selectedPair.FocusedResponseA?.Artifact
                : selectedPair.ResponseA?.Artifact;
            var artifactB = detailViewMode == DetailViewMode.Focused
                ? selectedPair.FocusedResponseB?.Artifact
                : selectedPair.ResponseB?.Artifact;

            if (artifactA is not null) { contentA = FormatArtifactPreview(await DataSource.ReadArtifactContentAsync(artifactA)); }
            if (artifactB is not null) { contentB = FormatArtifactPreview(await DataSource.ReadArtifactContentAsync(artifactB)); }
        }
        catch (Exception ex) { contentErrorMessage = ex.Message; }
        finally
        {
            isLoadingContent = false;
        }
    }



    private static Color GetRunStatusColor(RunStatus status) => status switch
    {
        RunStatus.Completed => Color.Success,
        RunStatus.Failed => Color.Error,
        RunStatus.Cancelled => Color.Warning,
        _ => Color.Primary,
    };

    private static string GetRunStatusMessage(ComparisonRun run)
    {
        if (!string.IsNullOrWhiteSpace(run.ErrorMessage))
        {
            return run.ErrorMessage!;
        }

        if (!string.IsNullOrWhiteSpace(run.Progress.Message))
        {
            return run.Progress.Message;
        }

        return run.IsTerminal ? "Run finished without result details." : "Run is still in progress.";
    }
    private static ArtifactContentPreview FormatArtifactPreview(ArtifactContentPreview preview)
    {
        string formattedContent = FormatStructuredText(preview.Content, preview.ContentType, preview.Artifact.ArtifactId);
        if (string.Equals(formattedContent, preview.Content, StringComparison.Ordinal))
        {
            return preview;
        }

        return new ArtifactContentPreview(
            preview.Artifact,
            formattedContent,
            preview.BytesRead,
            preview.IsTruncated,
            preview.ContentType,
            preview.TotalLength);
    }

    private static string FormatStructuredText(string text, string? contentType, string? fileName) =>
        DetectDocumentKind(contentType, fileName, text) switch
        {
            StructuredDocumentKind.Json => TryFormatJson(text),
            StructuredDocumentKind.Xml => TryFormatXml(text),
            _ => text,
        };

    private static string TryFormatJson(string text)
    {
        try
        {
            using JsonDocument document = JsonDocument.Parse(text);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return text;
        }
    }

    private static string TryFormatXml(string text)
    {
        try
        {
            XDocument document = XDocument.Parse(text, LoadOptions.None);
            return document.ToString(SaveOptions.None);
        }
        catch (Exception ex) when (ex is XmlException or InvalidOperationException)
        {
            return text;
        }
    }

    private static StructuredDocumentKind DetectDocumentKind(string? contentType, string? fileName, string text)
    {
        if (contentType?.Contains("json", StringComparison.OrdinalIgnoreCase) == true)
        {
            return StructuredDocumentKind.Json;
        }

        if (contentType?.Contains("xml", StringComparison.OrdinalIgnoreCase) == true)
        {
            return StructuredDocumentKind.Xml;
        }

        string extension = Path.GetExtension(fileName ?? string.Empty);
        if (string.Equals(extension, ".json", StringComparison.OrdinalIgnoreCase))
        {
            return StructuredDocumentKind.Json;
        }

        if (string.Equals(extension, ".xml", StringComparison.OrdinalIgnoreCase))
        {
            return StructuredDocumentKind.Xml;
        }

        ReadOnlySpan<char> firstNonWhitespace = text.AsSpan().TrimStart();
        if (firstNonWhitespace.Length == 0)
        {
            return StructuredDocumentKind.Unknown;
        }

        return firstNonWhitespace[0] switch
        {
            '{' or '[' => StructuredDocumentKind.Json,
            '<' => StructuredDocumentKind.Xml,
            _ => StructuredDocumentKind.Unknown,
        };
    }
    private IReadOnlyList<StaticReportPropertyDifferenceSummary> GetFilteredDifferenceProperties()
    {
        if (differenceIndex is null) { return Array.Empty<StaticReportPropertyDifferenceSummary>(); }
        if (string.IsNullOrWhiteSpace(allDifferencesFilter)) { return differenceIndex.Properties; }
        string filter = allDifferencesFilter.Trim();
        return differenceIndex.Properties
            .Where(property => property.NormalizedPath.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || property.PropertyPath.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || property.Category.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || property.AffectedPairs.Any(pair => pair.RelativePath.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || (pair.ValueA?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true)
                    || (pair.ValueB?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true)))
            .ToList();
    }

    private static IReadOnlyList<PropertyTreeNode> BuildDifferenceTree(IReadOnlyList<StaticReportPropertyDifferenceSummary> properties)
    {
        List<PropertyTreeNode> roots = new List<PropertyTreeNode>();
        Dictionary<string, PropertyTreeNode> nodeMap = new Dictionary<string, PropertyTreeNode>(StringComparer.OrdinalIgnoreCase);
        foreach (StaticReportPropertyDifferenceSummary property in properties)
        {
            string[] segments = property.NormalizedPath.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (segments.Length == 0) { segments = new[] { property.NormalizedPath }; }
            PropertyTreeNode? parent = null;
            string currentPath = string.Empty;
            for (int index = 0; index < segments.Length; index++)
            {
                string segment = segments[index];
                currentPath = string.IsNullOrEmpty(currentPath) ? segment : $"{currentPath}.{segment}";
                bool isLeaf = index == segments.Length - 1;
                if (!nodeMap.TryGetValue(currentPath, out PropertyTreeNode? node))
                {
                    node = new PropertyTreeNode(segment, isLeaf ? property.NormalizedPath : currentPath)
                    {
                        Expanded = index < 2,
                        IsLeaf = isLeaf,
                    };
                    nodeMap.Add(currentPath, node);
                    if (parent is null) { roots.Add(node); }
                    else
                    {
                        parent.Children ??= new List<TreeItemData<string>>();
                        parent.Children.Add(node);
                    }
                }

                if (isLeaf)
                {
                    node.IsLeaf = true;
                    node.FullPath = property.NormalizedPath;
                    node.DifferenceCount += property.OccurrenceCount;
                    foreach (StaticReportAffectedPairDifference pair in property.AffectedPairs)
                    {
                        node.AffectedPairKeys.Add(pair.RelativePath);
                    }
                }

                parent = node;
            }
        }

        foreach (PropertyTreeNode root in roots)
        {
            CalculateTreeNodeCount(root);
        }

        return roots;
    }

    private static int CalculateTreeNodeCount(PropertyTreeNode node)
    {
        int total = node.DifferenceCount;
        foreach (PropertyTreeNode child in node.Children?.OfType<PropertyTreeNode>() ?? Enumerable.Empty<PropertyTreeNode>())
        {
            total += CalculateTreeNodeCount(child);
            node.AffectedPairKeys.UnionWith(child.AffectedPairKeys);
        }

        node.DifferenceCount = total;
        node.AffectedPairCount = node.AffectedPairKeys.Count;
        return total;
    }

    private async Task SelectPropertyTreeNode(TreeItemData<string> treeItem)
    {
        if (treeItem is not PropertyTreeNode node) { return; }
        if (node.IsLeaf)
        {
            selectedPropertyPath = node.FullPath;
            await PushViewStateToUrlAsync();
            await ScrollToPropertyDetailAsync();
        }
        else { node.Expanded = !node.Expanded; }
    }

    private void ExpandAllDifferenceNodes()
    {
        IReadOnlyList<PropertyTreeNode> nodes = DifferenceTreeNodes;
        int count = CountTreeNodes(nodes);
        if (count > 2500)
        {
            foreach (PropertyTreeNode node in nodes) { SetExpandedToDepth(node, 0, 3); }
            differenceTreeInfoMessage = $"Large tree detected ({count:N0} nodes). Expanded the first 3 levels.";
        }
        else
        {
            foreach (PropertyTreeNode node in nodes) { SetExpandedRecursive(node, true); }
            differenceTreeInfoMessage = string.Empty;
        }
    }

    private void CollapseAllDifferenceNodes()
    {
        foreach (PropertyTreeNode node in DifferenceTreeNodes) { SetExpandedRecursive(node, false); }
        differenceTreeInfoMessage = string.Empty;
    }

    private static void SetExpandedRecursive(TreeItemData<string> treeItem, bool expanded)
    {
        treeItem.Expanded = expanded;
        foreach (TreeItemData<string> child in treeItem.Children ?? Enumerable.Empty<TreeItemData<string>>()) { SetExpandedRecursive(child, expanded); }
    }

    private static void SetExpandedToDepth(TreeItemData<string> treeItem, int depth, int maxDepth)
    {
        treeItem.Expanded = depth < maxDepth;
        foreach (TreeItemData<string> child in treeItem.Children ?? Enumerable.Empty<TreeItemData<string>>()) { SetExpandedToDepth(child, depth + 1, maxDepth); }
    }

    private static int CountTreeNodes(IEnumerable<TreeItemData<string>> roots)
    {
        int count = 0;
        Stack<TreeItemData<string>> stack = new Stack<TreeItemData<string>>(roots);
        while (stack.Count > 0)
        {
            TreeItemData<string> node = stack.Pop();
            count++;
            foreach (TreeItemData<string> child in node.Children ?? Enumerable.Empty<TreeItemData<string>>()) { stack.Push(child); }
        }

        return count;
    }
