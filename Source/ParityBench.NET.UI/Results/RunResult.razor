    private async Task OnSyncScrollChangedAsync(bool value)
    {
        syncScroll = value;
        await SetSyncedScrollAsync(detailViewMode == DetailViewMode.Full && syncScroll && !isLoadingContent && string.IsNullOrWhiteSpace(contentErrorMessage));
