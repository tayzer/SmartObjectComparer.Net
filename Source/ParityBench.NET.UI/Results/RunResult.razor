    private void RestoreFiltersFromUrl()
    {
        try
        {
            Dictionary<string, string> query = ParseQueryString(new Uri(Nav.Uri).Query);
            if (query.TryGetValue("q", out string? q)) { searchFilter = q; }
            if (query.TryGetValue("status", out string? status) && !string.IsNullOrWhiteSpace(status)) { statusFilter = status; }
            if (query.TryGetValue("category", out string? category) && !string.IsNullOrWhiteSpace(category)) { categoryFilter = category; }
        }
        catch { }
    }

    private async Task RestoreSelectionFromUrlAsync()
    {
        try
        {
            Dictionary<string, string> query = ParseQueryString(new Uri(Nav.Uri).Query);
            if (query.TryGetValue("pair", out string? pairValue) && !string.IsNullOrWhiteSpace(pairValue))
            {
                RequestPairResult? pair = detailPage?.Items.FirstOrDefault(item => string.Equals(item.RelativePath, pairValue, StringComparison.Ordinal));
                if (pair is not null) { await SelectPairAsync(pair); }
            }

            if (query.TryGetValue("prop", out string? propValue) && !string.IsNullOrWhiteSpace(propValue))
            {
                analysisTabIndex = 1;
                if (differenceIndex is null) { await LoadDifferenceIndexAsync(); }
                if (differenceIndex?.Properties.Any(property => string.Equals(property.NormalizedPath, propValue, StringComparison.OrdinalIgnoreCase)) == true)
                {
                    selectedPropertyPath = propValue;
                }
            }
        }
        catch { }
    }

    private async Task PushViewStateToUrlAsync()
    {
        try
        {
            Dictionary<string, string?> query = new Dictionary<string, string?>();
            if (!string.IsNullOrWhiteSpace(searchFilter)) { query["q"] = searchFilter; }
            if (!string.Equals(statusFilter, AllFilter, StringComparison.Ordinal)) { query["status"] = statusFilter; }
            if (!string.Equals(categoryFilter, AllFilter, StringComparison.Ordinal)) { query["category"] = categoryFilter; }
            if (selectedPair is not null) { query["pair"] = selectedPair.RelativePath; }
            if (!string.IsNullOrWhiteSpace(selectedPropertyPath)) { query["prop"] = selectedPropertyPath; }

            string basePath = new Uri(Nav.Uri).GetLeftPart(UriPartial.Path);

            // Intentionally bypasses NavigationManager.NavigateTo here: Blazor's navigateTo
            // resets scroll position to the top on every call (it's designed to mimic a real
            // page navigation), which made the whole page jump to top on every keystroke/filter
            // change/selection. This is pure URL bookkeeping (for copy/share/refresh), not a
            // real navigation, so we update the address bar directly via history.replaceState
            // instead, which doesn't touch scroll position.
            await JS.InvokeVoidAsync("parityBenchReplaceUrl", BuildQueryString(basePath, query));
        }
        catch { }
    }

    private static Dictionary<string, string> ParseQueryString(string query)
    {
        Dictionary<string, string> values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(query)) { return values; }
        string normalized = query.TrimStart('?');
        foreach (string pair in normalized.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            string[] parts = pair.Split('=', 2);
            string key = Uri.UnescapeDataString(parts[0]);
            if (string.IsNullOrWhiteSpace(key)) { continue; }
            values[key] = parts.Length == 2 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
        }

        return values;
    }

    private static string BuildQueryString(string basePath, Dictionary<string, string?> query)
    {
        IEnumerable<string> pairs = query
            .Where(entry => !string.IsNullOrEmpty(entry.Value))
            .Select(entry => $"{Uri.EscapeDataString(entry.Key)}={Uri.EscapeDataString(entry.Value!)}");
        string queryString = string.Join("&", pairs);
        return queryString.Length == 0 ? basePath : $"{basePath}?{queryString}";
    }

    private RenderFragment Stat(string label, int value, Color color) => @<MudPaper Outlined="true" Class="pa-3 v1-report-stat"><MudText Typo="Typo.h5" Color="@color">@value.ToString("N0", CultureInfo.InvariantCulture)</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText></MudPaper>;

    private IReadOnlyList<StructuredDifferenceNode> GetStructuredDifferenceTree(RequestPairResult pair) =>
        BuildStructuredDifferenceTree(pair.Differences.Where(MatchesStructuredSearch).Where(MatchesAcceptedDifferenceVisibility));

    private static IReadOnlyList<StructuredDifferenceNode> BuildStructuredDifferenceTree(IEnumerable<ComparisonDifference> differences)
    {
        List<StructuredDifferenceNode> roots = new List<StructuredDifferenceNode>();
        Dictionary<string, StructuredDifferenceNode> nodesByPath = new Dictionary<string, StructuredDifferenceNode>(StringComparer.OrdinalIgnoreCase);

        foreach (ComparisonDifference difference in differences.OrderBy(difference => StaticReportDifferenceIndexBuilder.NormalizePropertyPath(difference.PropertyPath), StringComparer.OrdinalIgnoreCase))
        {
            string normalizedPath = StaticReportDifferenceIndexBuilder.NormalizePropertyPath(difference.PropertyPath);
            string[] segments = normalizedPath.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (segments.Length == 0) { segments = new[] { normalizedPath }; }

            StructuredDifferenceNode? parent = null;
            string currentPath = string.Empty;
            for (int index = 0; index < segments.Length; index++)
            {
                string segment = segments[index];
                currentPath = string.IsNullOrEmpty(currentPath) ? segment : $"{currentPath}.{segment}";
                if (!nodesByPath.TryGetValue(currentPath, out StructuredDifferenceNode? node))
                {
                    node = new StructuredDifferenceNode(segment, currentPath);
                    nodesByPath.Add(currentPath, node);
                    if (parent is null) { roots.Add(node); }
                    else { parent.Children.Add(node); }
                }

                if (index == segments.Length - 1)
                {
                    node.Differences.Add(difference);
                }

                parent = node;
            }
        }

        SortStructuredDifferenceNodes(roots);
        return roots;
    }

    private static int CountStructuredDifferences(IReadOnlyList<StructuredDifferenceNode> nodes)
    {
        int total = 0;
        foreach (StructuredDifferenceNode node in nodes)
        {
            total += node.Differences.Count;
            total += CountStructuredDifferences(node.Children);
        }

        return total;
    }

    private static void SortStructuredDifferenceNodes(List<StructuredDifferenceNode> nodes)
    {
        nodes.Sort((left, right) => string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase));
        foreach (StructuredDifferenceNode node in nodes)
        {
            node.Differences.Sort((left, right) => string.Compare(left.PropertyPath, right.PropertyPath, StringComparison.OrdinalIgnoreCase));
            SortStructuredDifferenceNodes(node.Children);
        }
    }

    private RenderFragment RenderStructuredDifferenceNode(StructuredDifferenceNode node, int depth) => @<div class="v1-structured-node">
        @{
            bool isLeaf = node.Children.Count == 0;
            bool isCollapsed = !string.IsNullOrWhiteSpace(structuredSearchFilter)
                ? false
                : IsStructuredGroupCollapsed(node.FullPath);
            int perGroupCap = showAllDifferences ? node.Differences.Count : Math.Min(100, node.Differences.Count);
            int remainingBudget = Math.Max(0, StructuredGlobalRenderCap - structuredRenderedRowCount);
            List<ComparisonDifference> visibleDifferences = node.Differences.Take(Math.Min(perGroupCap, remainingBudget)).ToList();
            structuredRenderedRowCount += visibleDifferences.Count;
            string indent = $"padding-left: {Math.Min(depth * 1.1, 8):0.##}rem;";
        }
        @if (isLeaf)
        {
            @foreach (ComparisonDifference difference in visibleDifferences)
            {
                @RenderStructuredDifferenceRow(difference, node.Name, depth)
            }
            @RenderStructuredDifferenceLimit(node.Differences.Count, visibleDifferences.Count)
        }
        else
        {
            <MudButton Class="v1-structured-node-header"
                       Style="@indent"
                       title="@node.FullPath"
                       role="row"
                       aria-level="@(depth + 1)"
                       aria-expanded="@(!isCollapsed)"
                       Variant="Variant.Text"
                       FullWidth="true"
                       OnClick="@(() => ToggleStructuredGroup(node.FullPath))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="flex-wrap px-1 py-1">
                    <MudIcon Class="v1-structured-node-toggle" Icon="@(isCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                    <span class="v1-structured-node-name">@node.Name</span>
                    <span class="v1-structured-count">@node.DifferenceCount diff@(node.DifferenceCount == 1 ? string.Empty : "s")</span>
                </MudStack>
            </MudButton>
            @if (!isCollapsed)
            {
                @foreach (ComparisonDifference difference in visibleDifferences)
                {
                    @RenderStructuredDifferenceRow(difference, node.Name, depth + 1)
                }
                @RenderStructuredDifferenceLimit(node.Differences.Count, visibleDifferences.Count)
                <div class="v1-structured-node-children" role="group">
                    @foreach (StructuredDifferenceNode child in node.Children)
                    {
                        @RenderStructuredDifferenceNode(child, depth + 1)
                    }
                </div>
            }
        }
    </div>;

    private RenderFragment RenderStructuredDifferenceRow(ComparisonDifference difference, string propertyLabel, int depth) => @<div class="v1-structured-diff-row" role="row" aria-level="@(depth + 1)" title="@difference.PropertyPath">
        @{
            AcceptedDifferenceProfile? profile = GetAcceptedDifferenceProfile(difference);
            string propertyIndent = $"padding-left: {Math.Min((depth * 1.1) + .55, 8.55):0.##}rem;";
        }
        <div class="v1-structured-diff-cell v1-structured-diff-prop" style="@propertyIndent" role="gridcell">
            <code>@propertyLabel</code>
        </div>
        <div class="v1-structured-diff-cell v1-structured-diff-value v1-diff-a" data-label="@LabelA" role="gridcell">
            <span class="@(difference.ValueA is null ? "v1-structured-null" : string.Empty)">@(difference.ValueA ?? "null")</span>
        </div>
        <div class="v1-structured-diff-cell v1-structured-diff-value v1-diff-b" data-label="@LabelB" role="gridcell">
            <span class="@(difference.ValueB is null ? "v1-structured-null" : string.Empty)">@(difference.ValueB ?? "null")</span>
        </div>
        <div class="v1-structured-diff-cell v1-structured-diff-actions" role="gridcell">
            <MudChip T="string" Size="Size.Small" Color="@GetAcceptedDifferenceColor(difference)">@GetAcceptedDifferenceLabel(difference)</MudChip>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.BookmarkAdd" Disabled="@AcceptedDifferences.IsReadOnly" OnClick="@(() => OpenAcceptedDifferenceEditor(difference))">@(profile is null ? "Track" : "Edit")</MudButton>
            @if (profile is not null && !AcceptedDifferences.IsReadOnly)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@(() => ClearAcceptedDifferenceAsync(difference))">Clear</MudButton>
            }
        </div>
    </div>;

    private static RenderFragment RenderStructuredDifferenceLimit(int totalCount, int visibleCount) =>
        totalCount <= visibleCount
            ? _ => { }
            : @<div class="v1-structured-limit" role="row">And @(totalCount - visibleCount) more differences in this branch...</div>;

    private bool IsStructuredGroupCollapsed(string groupKey) => collapsedStructuredGroups.Contains(groupKey);

    private void ToggleStructuredGroup(string groupKey)
    {
        if (!collapsedStructuredGroups.Add(groupKey))
        {
            collapsedStructuredGroups.Remove(groupKey);
        }
    }
    private bool MatchesStructuredSearch(ComparisonDifference difference)
    {
        if (string.IsNullOrWhiteSpace(structuredSearchFilter)) { return true; }
        string filter = structuredSearchFilter.Trim();
        return difference.PropertyPath.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || (difference.ValueA?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true)
            || (difference.ValueB?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true)
            || (difference.Message?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true);
    }

    private async Task ReloadAcceptedMatchesAsync()
    {
        List<ComparisonDifference> differences = new List<ComparisonDifference>();
        if (detailPage is not null)
        {
            differences.AddRange(detailPage.Items.SelectMany(item => item.Differences).Where(IsStructuredAcceptedDifferenceCandidate));
        }

        if (selectedPair is not null)
        {
            differences.AddRange(selectedPair.Differences.Where(IsStructuredAcceptedDifferenceCandidate));
        }

        acceptedDifferenceMatches = new Dictionary<string, AcceptedDifferenceProfile>(
            await AcceptedDifferences.MatchAsync(differences),
            StringComparer.Ordinal);
    }

    private bool MatchesAcceptedDifferenceVisibility(ComparisonDifference difference)
    {
        if (!hideAcceptedDifferences)
        {
            return true;
        }

        AcceptedDifferenceProfile? profile = GetAcceptedDifferenceProfile(difference);
        return profile?.Status is not (AcceptedDifferenceStatus.AcceptedDifference or AcceptedDifferenceStatus.KnownBug);
    }

    private AcceptedDifferenceProfile? GetAcceptedDifferenceProfile(ComparisonDifference difference)
    {
        string fingerprint = AcceptedDifferences.CreateFingerprint(difference).Fingerprint;
        return acceptedDifferenceMatches.GetValueOrDefault(fingerprint);
    }

    private string GetAcceptedDifferenceLabel(ComparisonDifference difference)
    {
        AcceptedDifferenceProfile? profile = GetAcceptedDifferenceProfile(difference);
        return profile?.Status switch
        {
            AcceptedDifferenceStatus.AcceptedDifference => "Accepted",
            AcceptedDifferenceStatus.KnownBug when !string.IsNullOrWhiteSpace(profile.TicketId) => $"Bug: {profile.TicketId}",
            AcceptedDifferenceStatus.KnownBug => "Known Bug",
            AcceptedDifferenceStatus.FixedVerified => "Fixed / Verified",
            _ => "New",
        };
    }

    private Color GetAcceptedDifferenceColor(ComparisonDifference difference) => GetAcceptedDifferenceProfile(difference)?.Status switch
    {
        AcceptedDifferenceStatus.AcceptedDifference => Color.Success,
        AcceptedDifferenceStatus.KnownBug => Color.Warning,
        AcceptedDifferenceStatus.FixedVerified => Color.Info,
        _ => Color.Default,
    };

    private int GetTrackingCount(AcceptedDifferenceStatus? status)
    {
        IEnumerable<ComparisonDifference> differences = selectedPair?.Differences.Where(IsStructuredAcceptedDifferenceCandidate) ?? Array.Empty<ComparisonDifference>();
        return status is null
            ? differences.Count(difference => GetAcceptedDifferenceProfile(difference) is null)
            : differences.Count(difference => GetAcceptedDifferenceProfile(difference)?.Status == status.Value);
    }

    private void OpenAcceptedDifferenceEditor(ComparisonDifference difference)
    {
        editingAcceptedDifference = difference;
        AcceptedDifferenceProfile? profile = GetAcceptedDifferenceProfile(difference);
        acceptedDifferenceEditorStatus = profile?.Status ?? AcceptedDifferenceStatus.AcceptedDifference;
        acceptedDifferenceEditorNotes = profile?.Notes ?? string.Empty;
        acceptedDifferenceEditorTicket = profile?.TicketId ?? string.Empty;
        acceptedDifferenceErrorMessage = null;
    }

    private void CloseAcceptedDifferenceEditor()
    {
        editingAcceptedDifference = null;
        acceptedDifferenceErrorMessage = null;
    }

    private bool CanSaveAcceptedDifference => editingAcceptedDifference is not null &&
        (acceptedDifferenceEditorStatus != AcceptedDifferenceStatus.KnownBug || !string.IsNullOrWhiteSpace(acceptedDifferenceEditorTicket));

    private async Task SaveAcceptedDifferenceAsync()
    {
        if (editingAcceptedDifference is null)
        {
            return;
        }

        try
        {
            await AcceptedDifferences.SaveAsync(editingAcceptedDifference, acceptedDifferenceEditorStatus, acceptedDifferenceEditorNotes, acceptedDifferenceEditorTicket);
            CloseAcceptedDifferenceEditor();
            await ReloadAcceptedMatchesAsync();
        }
        catch (Exception ex)
        {
            acceptedDifferenceErrorMessage = ex.Message;
        }
    }

    private async Task ClearAcceptedDifferenceAsync(ComparisonDifference difference)
    {
        await AcceptedDifferences.RemoveAsync(difference);
        await ReloadAcceptedMatchesAsync();
    }

    private static bool IsStructuredAcceptedDifferenceCandidate(ComparisonDifference difference)
    {
        string path = difference.PropertyPath ?? string.Empty;
        return !string.Equals(path, "HttpStatus", StringComparison.OrdinalIgnoreCase)
            && !path.StartsWith("Body.", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(path, "BodyPreview", StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesCategoryFilter(RequestPairResult item) => string.Equals(categoryFilter, AllFilter, StringComparison.OrdinalIgnoreCase)
        || string.Equals(GetPairCategory(item), categoryFilter, StringComparison.OrdinalIgnoreCase)
        || item.Differences.Any(difference => string.Equals(GetDifferenceCategory(difference), categoryFilter, StringComparison.OrdinalIgnoreCase));

    private static RequestPairOutcome? ParseStatusFilter(string value) => Enum.TryParse<RequestPairOutcome>(value, out var outcome) ? outcome : null;
    private bool IsSideBySideRawContentView => detailViewMode is DetailViewMode.Full or DetailViewMode.Focused;
    private static bool HasArtifactContent(RequestPairResult pair) => pair.ResponseA?.Artifact is not null || pair.ResponseB?.Artifact is not null;
    private static string FormatDate(DateTimeOffset value) => value.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
    private static string FormatDuration(TimeSpan value) => value.TotalMinutes >= 1 ? $"{(int)value.TotalMinutes}m {value.Seconds:D2}s" : value.TotalSeconds >= 1 ? $"{value.TotalSeconds:F2}s" : $"{value.TotalMilliseconds:F0} ms";
    private static string FormatRate(long count, TimeSpan duration) => duration <= TimeSpan.Zero ? "0.00" : (count / duration.TotalSeconds).ToString("F2", CultureInfo.InvariantCulture);
    private static string FormatMiBRate(long bytes, TimeSpan duration) => duration <= TimeSpan.Zero ? "0.00" : (bytes / 1024d / 1024d / duration.TotalSeconds).ToString("F2", CultureInfo.InvariantCulture);
    private static string FormatBool(bool value) => value ? "on" : "off";
    private static string FormatRawLine(StaticReportRawTextDifference difference) => difference.LineNumberA.HasValue && difference.LineNumberB.HasValue ? $"{difference.LineNumberA}/{difference.LineNumberB}" : difference.LineNumberA?.ToString(CultureInfo.InvariantCulture) ?? difference.LineNumberB?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    private string GetPairRowClass(RequestPairResult pair, int index) => selectedPair is not null && string.Equals(selectedPair.RelativePath, pair.RelativePath, StringComparison.OrdinalIgnoreCase) ? "v1-selected-pair" : string.Empty;
    private static Color GetDifferenceChipColor(RequestPairResult pair) => pair.Outcome == RequestPairOutcome.Equal ? Color.Success : pair.Outcome == RequestPairOutcome.ExecutionFailed ? Color.Warning : Color.Error;
    private static Color GetStatusCodeColor(int statusCode) => statusCode switch { >= 200 and < 300 => Color.Success, >= 300 and < 400 => Color.Info, >= 400 and < 500 => Color.Warning, >= 500 => Color.Error, _ => Color.Default };
    private static Color GetOutcomeColor(RequestPairOutcome outcome) => outcome switch { RequestPairOutcome.Equal => Color.Success, RequestPairOutcome.Different => Color.Error, RequestPairOutcome.StatusCodeMismatch => Color.Warning, RequestPairOutcome.BothNonSuccess => Color.Error, RequestPairOutcome.ExecutionFailed => Color.Warning, _ => Color.Default };
    private static string GetOutcomeIcon(RequestPairOutcome outcome) => outcome switch { RequestPairOutcome.Equal => Icons.Material.Filled.CheckCircle, RequestPairOutcome.Different => Icons.Material.Filled.Cancel, RequestPairOutcome.StatusCodeMismatch => Icons.Material.Filled.SyncProblem, RequestPairOutcome.BothNonSuccess => Icons.Material.Filled.ErrorOutline, RequestPairOutcome.ExecutionFailed => Icons.Material.Filled.Warning, _ => Icons.Material.Filled.Help };

    private static string GetPairCategory(RequestPairResult item)
    {
        if (item.Outcome == RequestPairOutcome.Equal) { return "Equal"; }
        if (item.Outcome == RequestPairOutcome.ExecutionFailed) { return "Errors"; }
        if (item.Outcome == RequestPairOutcome.StatusCodeMismatch) { return "HTTP Status"; }
        if (item.Outcome == RequestPairOutcome.BothNonSuccess) { return "Non-Success"; }
        return item.Differences.Count == 0 ? "Other" : GetDifferenceCategory(item.Differences[0]);
    }

    private static string GetDifferenceCategory(ComparisonDifference difference)
    {
        string path = difference.PropertyPath ?? string.Empty;
        string message = difference.Message ?? string.Empty;
        if (string.Equals(path, "HttpStatus", StringComparison.OrdinalIgnoreCase)) { return "HTTP Status"; }
        if (path.StartsWith("Body.", StringComparison.OrdinalIgnoreCase)) { return "Raw Body"; }
        if (message.Contains("missing", StringComparison.OrdinalIgnoreCase) || message.Contains("null", StringComparison.OrdinalIgnoreCase) || difference.ValueA is null || difference.ValueB is null) { return "Missing Properties"; }
        if (path.Contains('[', StringComparison.Ordinal) || message.Contains("collection", StringComparison.OrdinalIgnoreCase)) { return "Collection / Order"; }
        if (message.Contains("type", StringComparison.OrdinalIgnoreCase)) { return "Critical"; }
        return "Value Differences";
    }

    private static string SanitizeFileName(string value)
    {
        char[] invalid = Path.GetInvalidFileNameChars();
        string sanitized = new string(value.Select(character => invalid.Contains(character) ? '-' : character).ToArray());
        return string.IsNullOrWhiteSpace(sanitized) ? "comparison-result" : sanitized;
    }

    private enum DetailViewMode { Structured, Raw, Focused, Full }
    private enum StructuredDocumentKind { Unknown, Json, Xml }
}

