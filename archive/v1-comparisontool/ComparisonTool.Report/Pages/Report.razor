@page "/"
@page "/index.html"
@using ComparisonTool.Core.Comparison
@using ComparisonTool.Core.Comparison.Analysis
@using ComparisonTool.Core.Comparison.Results
@using ComparisonTool.Core.RequestComparison.Services
@using ComparisonTool.UI.Comparison
@using KellermanSoftware.CompareNetObjects
@inject ReportDataService ReportDataService
@inject IComparisonService ComparisonService
@inject RawTextComparisonService RawTextComparisonService
@inject IJSRuntime JS
@inject ILogger<Report> Logger

@if (!isLoaded)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h5" Class="mt-4">Loading Report Data...</MudText>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Style="max-width: 600px;">@errorMessage</MudAlert>
        }
    </MudStack>
}
else if (FolderComparisonResult != null)
{
    <MudStack Spacing="4">
        <!-- Report Header -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Comparison Report</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    @if (metadata != null)
                    {
                        @if (!string.IsNullOrEmpty(metadata.ModelName))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@metadata.ModelName</MudChip>
                        }
                        @if (metadata.ElapsedSeconds > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@($"{metadata.ElapsedSeconds:F1}s")</MudChip>
                        }
                        @if (!string.IsNullOrEmpty(metadata.GeneratedAt))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Default">@metadata.GeneratedAt</MudText>
                        }
                    }
                </MudStack>
            </MudStack>
            @if (metadata != null)
            {
                <MudStack Row="true" Spacing="4" Class="mt-2 flex-wrap">
                    @if (!string.IsNullOrEmpty(metadata.Directory1))
                    {
                        <MudText Typo="Typo.body2"><strong>Expected:</strong> @metadata.Directory1</MudText>
                    }
                    @if (!string.IsNullOrEmpty(metadata.Directory2))
                    {
                        <MudText Typo="Typo.body2"><strong>Actual:</strong> @metadata.Directory2</MudText>
                    }
                    @if (!string.IsNullOrEmpty(metadata.EndpointA))
                    {
                        <MudText Typo="Typo.body2"><strong>@GetEndpointLabel(metadata.EndpointALabel, "Endpoint A"):</strong> @metadata.EndpointA</MudText>
                    }
                    @if (!string.IsNullOrEmpty(metadata.EndpointB))
                    {
                        <MudText Typo="Typo.body2"><strong>@GetEndpointLabel(metadata.EndpointBLabel, "Endpoint B"):</strong> @metadata.EndpointB</MudText>
                    }
                </MudStack>
            }
        </MudPaper>

        <!-- Comparison Timings -->
        @{
            var phaseTimings = GetPhaseTimings(FolderComparisonResult);
            var requestTimings = GetRequestTimings(FolderComparisonResult);
        }
        @if (phaseTimings != null)
        {
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Comparison Timings</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        @phaseTimings.ComparisonMode across @phaseTimings.TotalPairsCompared file pairs.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Total: @FormatElapsedTime(phaseTimings.TotalElapsedMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Discovery/Pairing: @FormatElapsedTime(phaseTimings.FileDiscoveryPairingMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Deserialization Work: @FormatElapsedTime(phaseTimings.DeserializationMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Comparison Work: @FormatElapsedTime(phaseTimings.ComparisonMs)</MudChip>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        @if (requestTimings != null)
        {
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Request Comparison Timings</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        @requestTimings.TotalRequests requests, @requestTimings.TotalPairsCompared response pairs.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Total: @FormatElapsedTime(requestTimings.TotalElapsedMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Parsing: @FormatElapsedTime(requestTimings.ParsingMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Execution: @FormatElapsedTime(requestTimings.RequestExecutionMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Comparison: @FormatElapsedTime(requestTimings.ResponseComparisonMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Focused Setup: @FormatElapsedTime(requestTimings.FocusedRawContentMs)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Finalization: @FormatElapsedTime(requestTimings.FinalizationMs)</MudChip>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
        @if (EnhancedStructuralAnalysis != null)
        {
            <ComparisonRunDetails Analysis="@EnhancedStructuralAnalysis"
                                  FolderComparisonResult="@FolderComparisonResult"
                                  OnFileSelected="@HandleInspectorFileSelected" />
        }

        @if (!string.IsNullOrWhiteSpace(analysisErrorMessage))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Comparison Run Details Unavailable</MudText>
                    <MudText Typo="Typo.body2">@analysisErrorMessage</MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               Size="Size.Small"
                               OnClick="RetryEnhancedAnalysis"
                               aria-label="Retry comparison run details analysis">
                        Retry Comparison Run Details
                    </MudButton>
                </MudStack>
            </MudAlert>
        }

        <!-- File Pair List -->
        <FileComparisonResults Result="@FolderComparisonResult"
                               SelectedPairIndex="@SelectedPairIndex"
                               OnPairSelected="@SelectPairResult"
                               OnExportAll="@ExportAllResults" />

        <!-- Pair Detail View -->
        @if (SelectedPairIndex >= 0 && SelectedPairIndex < FolderComparisonResult.FilePairResults.Count)
        {
            var selectedPair = FolderComparisonResult.FilePairResults[SelectedPairIndex];

            @if (selectedPair.HasError)
            {
                <ErrorDetailView SelectedPair="@selectedPair"
                                 RawFileDifferences="@RawFileDifferences" />
            }
            else if (ShouldRenderRawTextDetail(selectedPair))
            {
                <RawTextDifferencesView SelectedPair="@selectedPair"
                                        OnExportResults="@ExportSelectedResults"
                                        SectionId="report-detailed-differences-section" />
            }
            else if (DifferenceSummary != null)
            {
                <DetailedDifferencesView SelectedPair="@selectedPair"
                                         DifferenceSummary="@DifferenceSummary"
                                         ComparisonResult="@ComparisonResult"
                                         ShowAllDifferences="@ShowAllDifferences"
                                         OnToggleShowAll="@ToggleShowAllDifferences"
                                         OnExportResults="@ExportSelectedResults"
                                         FolderResult="@FolderComparisonResult" />
            }
        }
    </MudStack>
}

@code {
    private static string GetEndpointLabel(string? label, string fallback) =>
        string.IsNullOrWhiteSpace(label) ? fallback : label;

    private bool isLoaded;
    private string? errorMessage;
    private string? analysisErrorMessage;

    private MultiFolderComparisonResult? FolderComparisonResult;
    private EnhancedStructuralDifferenceAnalyzer.EnhancedStructuralAnalysisResult? EnhancedStructuralAnalysis;
    private ReportMetadata? metadata;

    private ComparisonResult? ComparisonResult;
    private DifferenceSummary? DifferenceSummary;
    private int SelectedPairIndex = -1;
    private bool ShowAllDifferences;
    private List<RawTextDifference>? RawFileDifferences;
    private const int LargePairShowAllResetThreshold = 5000;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var data = await ReportDataService.LoadAsync();
                FolderComparisonResult = data.Result;
                EnhancedStructuralAnalysis = data.EnhancedAnalysis;
                metadata = data.Metadata;
                analysisErrorMessage = null;

                await EnsureEnhancedAnalysisAsync();

                // Auto-select first pair if there are differences
                if (FolderComparisonResult != null &&
                    FolderComparisonResult.FilePairResults.Count > 0 &&
                    !FolderComparisonResult.AllEqual)
                {
                    await SelectPairResult(0);
                }

                isLoaded = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load report data.");
                errorMessage = ex.Message;
            }

            StateHasChanged();
        }
    }

    private async Task RetryEnhancedAnalysis()
    {
        analysisErrorMessage = null;
        await EnsureEnhancedAnalysisAsync();
        StateHasChanged();
    }

    private async Task EnsureEnhancedAnalysisAsync()
    {
        if (FolderComparisonResult == null || FolderComparisonResult.AllEqual || EnhancedStructuralAnalysis != null)
        {
            return;
        }

        try
        {
            EnhancedStructuralAnalysis = await ComparisonService.AnalyzeStructualPatternsAsync(FolderComparisonResult);

            if (EnhancedStructuralAnalysis == null)
            {
                analysisErrorMessage = "Enhanced structural analysis did not return comparison run details.";
                return;
            }

            if (FolderComparisonResult.Metadata.ContainsKey("EnhancedStructuralAnalysis"))
            {
                FolderComparisonResult.Metadata["EnhancedStructuralAnalysis"] = EnhancedStructuralAnalysis;
            }
            else
            {
                FolderComparisonResult.Metadata.Add("EnhancedStructuralAnalysis", EnhancedStructuralAnalysis);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate comparison run details for the report.");
            analysisErrorMessage = ex.Message;
        }
    }

    private async Task SelectPairResult(int index)
    {
        if (FolderComparisonResult == null || index < 0 || index >= FolderComparisonResult.FilePairResults.Count)
        {
            return;
        }

        SelectedPairIndex = index;
        var selectedPair = FolderComparisonResult.FilePairResults[index];
        ComparisonResult = selectedPair.Result;
        DifferenceSummary = selectedPair.Summary;

        var diffCount = selectedPair.Result?.Differences?.Count ?? 0;
        if (diffCount > LargePairShowAllResetThreshold && ShowAllDifferences)
        {
            ShowAllDifferences = false;
        }

        // Compute raw file diff for error detail view
        if (selectedPair.HasError)
        {
            try
            {
                if (selectedPair.HasEmbeddedRawContent)
                {
                    RawFileDifferences = RawTextComparisonService.CompareContentRaw(
                        selectedPair.EmbeddedRawContentA,
                        selectedPair.EmbeddedRawContentB,
                        selectedPair.EmbeddedRawContentTruncatedA,
                        selectedPair.EmbeddedRawContentTruncatedB);
                }
                else
                {
                    RawFileDifferences = null;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to compute raw file differences.");
                RawFileDifferences = null;
            }
        }
        else
        {
            RawFileDifferences = null;
        }

        try
        {
            await JS.InvokeVoidAsync("scrollToElement", "report-detailed-differences-section");
        }
        catch
        {
            // Non-critical scroll failure
        }

        StateHasChanged();
    }

    private void HandleInspectorFileSelected(string fileName)
    {
        if (FolderComparisonResult == null)
        {
            return;
        }

        var normalizedFileName = NormalizeIdentifier(fileName);
        var selectedFileName = System.IO.Path.GetFileName(normalizedFileName);
        var index = FolderComparisonResult.FilePairResults.FindIndex(pair =>
            IdentifierEquals(pair.GetDisplayIdentifier(), normalizedFileName) ||
            IdentifierEquals(pair.RequestRelativePath, normalizedFileName) ||
            IdentifierEquals(pair.File1Name, normalizedFileName) ||
            IdentifierEquals(pair.File2Name, normalizedFileName) ||
            (!string.IsNullOrWhiteSpace(selectedFileName) &&
             (IdentifierEquals(System.IO.Path.GetFileName(pair.File1Name), selectedFileName) ||
              IdentifierEquals(System.IO.Path.GetFileName(pair.File2Name), selectedFileName))));

        if (index >= 0)
        {
            _ = SelectPairResult(index);
        }
    }

    private static string NormalizeIdentifier(string value)
    {
        return (value ?? string.Empty).Trim().Replace('\\', '/');
    }

    private static bool IdentifierEquals(string? left, string right)
    {
        if (string.IsNullOrWhiteSpace(left) || string.IsNullOrWhiteSpace(right))
        {
            return false;
        }

        return string.Equals(NormalizeIdentifier(left), NormalizeIdentifier(right), StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleShowAllDifferences()
    {
        ShowAllDifferences = !ShowAllDifferences;
    }

    private Task ExportAllResults() => Task.CompletedTask;

    private Task ExportSelectedResults() => Task.CompletedTask;

    private Task ExportSemanticAnalysis(string content) => Task.CompletedTask;

    private static bool ShouldRenderRawTextDetail(FilePairComparisonResult pair)
    {
        return pair.RawTextDifferences != null && pair.RawTextDifferences.Count > 0 && pair.Result == null;
    }

    private static ComparisonPhaseTimings? GetPhaseTimings(MultiFolderComparisonResult? result)
    {
        if (result?.Metadata == null)
        {
            return null;
        }

        return result.Metadata.TryGetValue(ComparisonPhaseTimings.MetadataKey, out var timingsObj)
            ? timingsObj as ComparisonPhaseTimings
            : null;
    }

    private static RequestComparisonRunTimings? GetRequestTimings(MultiFolderComparisonResult? result)
    {
        if (result?.Metadata == null)
        {
            return null;
        }

        return result.Metadata.TryGetValue(RequestComparisonRunTimings.MetadataKey, out var timingsObj)
            ? timingsObj as RequestComparisonRunTimings
            : null;
    }
    private static string FormatElapsedTime(long milliseconds)
    {
        if (milliseconds >= 60000)
        {
            var minutes = milliseconds / 60000;
            var seconds = (milliseconds % 60000) / 1000.0;
            return $"{minutes}m {seconds:F1}s";
        }

        if (milliseconds >= 1000)
        {
            return $"{milliseconds / 1000.0:F2}s";
        }

        return $"{milliseconds} ms";
    }
}
