{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ComparisonSettings": {
    "MaxFileSizeBytes": 52428800
  },
  "AcceptedDifferences": {
    "Enabled": true,
    "StorePath": "Data/accepted-differences.json"
  },
  "FeatureFlags": {
    "RequestComparisonEnabled": true
  },
  "RequestComparison": {
    "DefaultTimeoutMs": 30000,
    "MaxConcurrency": 32,
    "LargeBatchThreshold": 1000,
    "LargeBatchChunkSize": 500,
    "LargeBatchDefaultConcurrency": 32,
    "AlternateContracts": {
      "ExpectedJsonCustomerLookup": {
        "AuthorizationTokenUrl": "http://localhost:5055/api/mock/authorisation-token",
        "HttpClientName": "RequestComparison"
      }
    },
    "EndpointOptions": {
      "AllowCustom": true,
      "Endpoints": [
        {
          "Name": "Local Mock A",
          "Url": "http://localhost:5055/api/mock/a"
        },
        {
          "Name": "Local Mock B",
          "Url": "http://localhost:5055/api/mock/b"
        },
        {
          "Name": "Local Mock Customer Lookup SOAP",
          "Url": "http://localhost:5055/api/mock/customer-lookup/soap"
        },
        {
          "Name": "Local Mock Customer Lookup JSON",
          "Url": "http://localhost:5055/api/mock/customer-lookup/json"
        }
      ]
    }
  }
}
