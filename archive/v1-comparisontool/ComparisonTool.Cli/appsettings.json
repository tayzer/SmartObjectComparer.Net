{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "ComparisonTool.Core.Comparison.ComparisonService": "Information",
      "ComparisonTool.Core.Comparison.DirectoryComparisonService": "Information",
      "ComparisonTool.Core.Utilities.PerformanceTracker": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "ComparisonTool.Cli": "Information",
        "ComparisonTool.Core.Comparison.ComparisonService": "Information",
        "ComparisonTool.Core.Comparison.DirectoryComparisonService": "Information",
        "ComparisonTool.Core.Utilities.PerformanceTracker": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/cli-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ComparisonSettings": {
    "MaxDifferences": 100,
    "DefaultIgnoreCollectionOrder": false,
    "DefaultIgnoreStringCase": false,
    "DefaultIgnoreTrailingWhitespaceAtEnd": false
  },
  "RequestComparison": {
    "MaxConcurrency": 64,
    "DefaultTimeoutMs": 30000,
    "TempFileRetentionDays": 1,
    "AlternateContracts": {
      "ExpectedJsonCustomerLookup": {
        "AuthorizationTokenUrl": "http://localhost:5055/api/mock/authorisation-token",
        "HttpClientName": "RequestComparison"
      }
    },
    "EndpointOptions": {
      "AllowCustom": true,
      "Endpoints": [
        {
          "Name": "Local Mock A",
          "Url": "http://localhost:5055/api/mock/a"
        },
        {
          "Name": "Local Mock B",
          "Url": "http://localhost:5055/api/mock/b"
        },
        {
          "Name": "Local Mock Customer Lookup SOAP",
          "Url": "http://localhost:5055/api/mock/customer-lookup/soap",
          "ContentType": "application/xml",
          "DefaultHeaders": {
            "X-Mock-Contract": "soap"
          }
        },
        {
          "Name": "Local Mock Customer Lookup JSON",
          "Url": "http://localhost:5055/api/mock/customer-lookup/json",
          "DefaultHeaders": {
            "X-Mock-Contract": "json"
          }
        }
      ]
    }
  }
}
