@namespace ComparisonTool.UI.Comparison
@using ComparisonTool.Core.Comparison.Results
@using ComparisonTool.Core.RequestComparison.Models
@using ComparisonTool.Core.RequestComparison.Services
@using MudBlazor
@inject RawContentService RawContentService

<style>
    .raw-diff-line-a {
        background-color: rgba(211, 47, 47, 0.08) !important;
        border-left: 3px solid #d32f2f !important;
    }

    .raw-diff-line-b {
        background-color: rgba(46, 125, 50, 0.08) !important;
        border-left: 3px solid #2e7d32 !important;
    }

    .raw-diff-line-modified {
        background-color: rgba(245, 124, 0, 0.08) !important;
        border-left: 3px solid #f57c00 !important;
    }

    .raw-diff-line-status {
        background-color: rgba(156, 39, 176, 0.08) !important;
        border-left: 3px solid #9c27b0 !important;
    }

    .raw-diff-text {
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.825rem;
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>

<MudPaper Elevation="2" Class="mt-4" id="@SectionId">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-3"
              Style="background: var(--mud-palette-surface);">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" />
                @GetTitle()
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">
                @GetSubtitle()
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudSelect T="RawTextViewMode"
                       Value="selectedViewMode"
                       ValueChanged="OnViewModeChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="min-width: 170px;">
                <MudSelectItem Value="@RawTextViewMode.RawDifferences">Raw Differences</MudSelectItem>
                @if (SelectedPair.HasFocusedRawContent)
                {
                    <MudSelectItem Value="@RawTextViewMode.Focused">Focused</MudSelectItem>
                }
                <MudSelectItem Value="@RawTextViewMode.Full">Full</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="ExportResults">
                Export This Result
            </MudButton>
        </MudStack>
    </MudStack>
    <MudDivider />

    @* HTTP Status Code Banner *@
    @if (HasHttpStatusMetadata)
    {
        var statusCodeA = SelectedPair.HttpStatusCodeA!.Value;
        var statusCodeB = SelectedPair.HttpStatusCodeB!.Value;

        <div class="pa-4">
            <MudAlert Severity="@GetBannerSeverity()" Variant="Variant.Outlined" Class="mb-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudText Typo="Typo.body1"><strong>HTTP Status Codes:</strong></MudText>
                    <MudChip T="string" Size="Size.Medium"
                             Color="@GetStatusCodeColor(statusCodeA)"
                             Variant="Variant.Filled">
                        @LabelA: @statusCodeA
                    </MudChip>
                    @if (statusCodeA != statusCodeB)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Color="Color.Warning" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.DragHandle" Color="Color.Default" />
                    }
                    <MudChip T="string" Size="Size.Medium"
                             Color="@GetStatusCodeColor(statusCodeB)"
                             Variant="Variant.Filled">
                        @LabelB: @statusCodeB
                    </MudChip>
                </MudStack>
            </MudAlert>

            @if (SelectedPair.PairOutcome == RequestPairOutcome.StatusCodeMismatch)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-3">
                    <strong>Status code mismatch detected.</strong> One endpoint returned a success response while the other did not.
                    Response bodies are compared as raw text below.
                </MudAlert>
            }
            else if (SelectedPair.PairOutcome == RequestPairOutcome.BothNonSuccess)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mb-3">
                    <strong>Both endpoints returned non-success responses.</strong> Neither endpoint processed the request successfully.
                    Error response bodies are compared as raw text below.
                </MudAlert>
            }
        </div>
    }

    @* Raw Text Differences *@
    @if (selectedViewMode == RawTextViewMode.RawDifferences && SelectedPair.RawTextDifferences != null && SelectedPair.RawTextDifferences.Count > 0)
    {
        <div class="pa-4">
            <MudText Typo="Typo.subtitle1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Difference" Class="mr-1" Size="Size.Small" />
                @SelectedPair.RawTextDifferences.Count Differences Found
            </MudText>

            <MudSimpleTable Dense="true" Hover="true" Striped="false" Style="overflow-x: auto;">
                <thead>
                    <tr>
                        <th style="width: 50px;">Type</th>
                        <th style="width: 70px;">Line</th>
                        <th>@GetColumnHeaderA()</th>
                        <th>@GetColumnHeaderB()</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var diff in SelectedPair.RawTextDifferences)
                    {
                        <tr class="@GetDiffRowClass(diff)">
                            <td>
                                @switch (diff.Type)
                                {
                                    case RawTextDifferenceType.StatusCodeDifference:
                                        <MudIcon Icon="@Icons.Material.Filled.Http" Size="Size.Small" Color="Color.Secondary" />
                                        break;
                                    case RawTextDifferenceType.OnlyInA:
                                        <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" Color="Color.Error" />
                                        break;
                                    case RawTextDifferenceType.OnlyInB:
                                        <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Color="Color.Success" />
                                        break;
                                    case RawTextDifferenceType.Modified:
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" />
                                        break;
                                }
                            </td>
                            <td>
                                @if (diff.LineNumberA.HasValue && diff.LineNumberB.HasValue)
                                {
                                    <span>@diff.LineNumberA / @diff.LineNumberB</span>
                                }
                                else if (diff.LineNumberA.HasValue)
                                {
                                    <span>@diff.LineNumberA / —</span>
                                }
                                else if (diff.LineNumberB.HasValue)
                                {
                                    <span>— / @diff.LineNumberB</span>
                                }
                            </td>
                            <td>
                                <span class="raw-diff-text">@(diff.TextA ?? "—")</span>
                            </td>
                            <td>
                                <span class="raw-diff-text">@(diff.TextB ?? "—")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }
    else if (selectedViewMode == RawTextViewMode.RawDifferences && SelectedPair.RawTextDifferences != null && SelectedPair.RawTextDifferences.Count == 0)
    {
        <div class="pa-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @GetEmptyStateMessage()
            </MudAlert>
        </div>
    }

    @if (!string.IsNullOrEmpty(SelectedPair.ErrorMessage))
    {
        <div class="pa-4">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                @SelectedPair.ErrorMessage
            </MudAlert>
        </div>
    }
</MudPaper>

@if (IsRawContentView)
{
    <MudPaper Elevation="2" Class="mt-4 pa-4">
        <SideBySideFileView ContentA="@rawContentA"
                            ContentB="@rawContentB"
                            FileNameA="@SelectedPair.File1Name"
                            FileNameB="@SelectedPair.File2Name"
                            IsTruncatedA="@rawContentTruncatedA"
                            IsTruncatedB="@rawContentTruncatedB"
                            IsLoading="@isLoadingRawContent"
                            ErrorMessage="@rawContentErrorMessage" />
    </MudPaper>
}

@code {
    [Parameter]
    public FilePairComparisonResult SelectedPair { get; set; } = null!;

    [Parameter]
    public EventCallback OnExportResults { get; set; }

    [Parameter]
    public string SectionId { get; set; } = "raw-text-differences-section";

    [Parameter]
    public string LabelA { get; set; } = "Endpoint A";

    [Parameter]
    public string LabelB { get; set; } = "Endpoint B";

    private bool HasHttpStatusMetadata => SelectedPair.HttpStatusCodeA.HasValue && SelectedPair.HttpStatusCodeB.HasValue;
    private string CurrentRawPairKey => string.Join("|",
        SelectedPair?.RequestRelativePath,
        SelectedPair?.File1Path,
        SelectedPair?.File2Path,
        SelectedPair?.FocusedFile1Path,
        SelectedPair?.FocusedFile2Path,
        SelectedPair?.ContentTypeA,
        SelectedPair?.ContentTypeB,
        selectedViewMode);

    private bool IsRawContentView => selectedViewMode is RawTextViewMode.Focused or RawTextViewMode.Full;

    private RawContentVariant CurrentRawContentVariant => selectedViewMode == RawTextViewMode.Focused
        ? RawContentVariant.Focused
        : RawContentVariant.Full;
    private RawTextViewMode selectedViewMode = RawTextViewMode.RawDifferences;
    private string? lastSelectedPairIdentity;
    private string rawContentA = string.Empty;
    private string rawContentB = string.Empty;
    private bool rawContentTruncatedA;
    private bool rawContentTruncatedB;
    private bool isLoadingRawContent;
    private string? rawContentErrorMessage;
    private string? lastLoadedPairKey;

    protected override void OnParametersSet()
    {
        var selectedPairIdentity = string.Join("|",
            SelectedPair?.RequestRelativePath,
            SelectedPair?.File1Path,
            SelectedPair?.File2Path,
            SelectedPair?.FocusedFile1Path,
            SelectedPair?.FocusedFile2Path);

        if (!string.Equals(selectedPairIdentity, lastSelectedPairIdentity, StringComparison.Ordinal))
        {
            selectedViewMode = RawTextViewMode.RawDifferences;
            lastSelectedPairIdentity = selectedPairIdentity;
        }

        if (!string.Equals(CurrentRawPairKey, lastLoadedPairKey, StringComparison.Ordinal))
        {
            ResetRawContentState();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsRawContentView && !string.Equals(CurrentRawPairKey, lastLoadedPairKey, StringComparison.Ordinal))
        {
            await LoadRawContentAsync();
        }
    }

    private async Task OnViewModeChanged(RawTextViewMode mode)
    {
        selectedViewMode = mode;
        ResetRawContentState();

        if (IsRawContentView)
        {
            isLoadingRawContent = true;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            isLoadingRawContent = false;
            await LoadRawContentAsync();
        }
    }

    private enum RawTextViewMode
    {
        Focused,
        RawDifferences,
        Full,
    }
    private static Color GetStatusCodeColor(int statusCode) => statusCode switch
    {
        >= 200 and < 300 => Color.Success,
        >= 300 and < 400 => Color.Info,
        >= 400 and < 500 => Color.Warning,
        >= 500 => Color.Error,
        _ => Color.Default,
    };

    private Severity GetBannerSeverity()
    {
        if (SelectedPair.PairOutcome == RequestPairOutcome.StatusCodeMismatch)
            return Severity.Warning;
        if (SelectedPair.PairOutcome == RequestPairOutcome.BothNonSuccess)
            return Severity.Error;
        return Severity.Info;
    }

    private string GetTitle() => HasHttpStatusMetadata
        ? "Raw Response Comparison"
        : "Raw File Comparison";

    private string GetSubtitle()
    {
        var displayIdentifier = SelectedPair.GetDisplayIdentifier();

        return HasHttpStatusMetadata
            ? SelectedPair.PairOutcome == RequestPairOutcome.StatusCodeMismatch
                ? $"{displayIdentifier} - Success vs non-success response comparison"
                : SelectedPair.PairOutcome == RequestPairOutcome.BothNonSuccess
                    ? $"{displayIdentifier} - Non-success response comparison"
                    : $"{displayIdentifier} - Raw response comparison"
            : $"{displayIdentifier} - Full raw content comparison";
    }

    private string GetColumnHeaderA() => HasHttpStatusMetadata ? LabelA : "File A";

    private string GetColumnHeaderB() => HasHttpStatusMetadata ? LabelB : "File B";

    private string GetEmptyStateMessage() => HasHttpStatusMetadata
        ? SelectedPair.HttpStatusCodeA != SelectedPair.HttpStatusCodeB
            ? "Response bodies are identical. The difference is only in HTTP status codes."
            : "Response bodies are identical."
        : "The file contents are identical.";

    private static string GetDiffRowClass(RawTextDifference diff) => diff.Type switch
    {
        RawTextDifferenceType.StatusCodeDifference => "raw-diff-line-status",
        RawTextDifferenceType.OnlyInA => "raw-diff-line-a",
        RawTextDifferenceType.OnlyInB => "raw-diff-line-b",
        RawTextDifferenceType.Modified => "raw-diff-line-modified",
        _ => "",
    };

    private void ResetRawContentState()
    {
        rawContentA = string.Empty;
        rawContentB = string.Empty;
        rawContentTruncatedA = false;
        rawContentTruncatedB = false;
        rawContentErrorMessage = null;
        lastLoadedPairKey = null;
    }

    private async Task LoadRawContentAsync()
    {
        if (SelectedPair == null || isLoadingRawContent)
        {
            return;
        }

        var pairKey = CurrentRawPairKey;
        if (string.Equals(pairKey, lastLoadedPairKey, StringComparison.Ordinal))
        {
            return;
        }

        isLoadingRawContent = true;
        rawContentErrorMessage = null;
        StateHasChanged();

        try
        {
            var result = await RawContentService.LoadRawContentAsync(SelectedPair, CurrentRawContentVariant);

            if (result.IsLoaded)
            {
                rawContentA = result.ContentA;
                rawContentB = result.ContentB;
                rawContentTruncatedA = result.IsTruncatedA;
                rawContentTruncatedB = result.IsTruncatedB;
            }
            else
            {
                rawContentErrorMessage = result.ErrorMessage;
            }

            lastLoadedPairKey = pairKey;
        }
        catch (Exception ex)
        {
            rawContentErrorMessage = $"Failed to load file content: {ex.Message}";
        }
        finally
        {
            isLoadingRawContent = false;
            StateHasChanged();
        }
    }

    private async Task ExportResults()
    {
        await OnExportResults.InvokeAsync();
    }
}
