        {
            var folderPath = await FolderPickerService.PickFolderAsync("Select request folder");
            if (string.IsNullOrWhiteSpace(folderPath))
            {
                return;
            }

            var normalizedFolderPath = Path.GetFullPath(folderPath);
            var requestFiles = EnumerateEligibleRequestFiles(normalizedFolderPath);

            selectedFiles = null;
            selectedFilePaths = null;
            selectedDirectoryPath = normalizedFolderPath;
            selectedDirectoryRequestCount = requestFiles.Count;
            largeBatchDefaultsApplied = false;
            errorMessage = requestFiles.Count == 0
                ? "No eligible .xml, .json, or .txt request files were found in the selected folder."
                : null;
            cacheHit = false;
            batchId = null;
            uploadedCount = 0;

            if (requestFiles.Count > 0)
            {
                cacheKey = ComputeDirectoryCacheKey(normalizedFolderPath, requestFiles);
                await TryResolveCachedBatchAsync();
                ApplyLargeBatchDefaultsForSelection();
            }
            else
            {
                cacheKey = null;
            }
        }
        catch (Exception ex)
        {
            selectedFiles = null;
            selectedFilePaths = null;
            selectedDirectoryPath = null;
            selectedDirectoryRequestCount = 0;
            largeBatchDefaultsApplied = false;
            cacheKey = null;
            cacheHit = false;
            batchId = null;
            uploadedCount = 0;
            errorMessage = $"Could not add request folder: {ex.Message}";
            Logger.LogError(ex, "Failed to add request folder through native picker");
        }
    }

    private async Task UploadFiles()
    {
        if (SelectedRequestFileCount == 0) return;
        if (cacheHit && !string.IsNullOrEmpty(batchId)) return;

        isUploading = true;
        errorMessage = null;
        
        try
        {
            if (!string.IsNullOrWhiteSpace(selectedDirectoryPath))
            {
                var result = await RequestComparisonGateway.StageRequestDirectoryAsync(selectedDirectoryPath, cacheKey);
                batchId = result.BatchId;
                uploadedCount = result.FileCount;
                cacheHit = result.CacheHit;
                return;
            }

            if (selectedFilePaths is { Count: > 0 })
            {
                var result = await RequestComparisonGateway.StageRequestFilesAsync(selectedFilePaths, cacheKey);
                batchId = result.BatchId;
                uploadedCount = result.FileCount;
                cacheHit = result.CacheHit;
                return;
            }

            if (selectedFiles == null || selectedFiles.Count == 0)
            {
                return;
            }

            var streams = new List<(string FileName, Stream Content)>();

            try
            {
                foreach (var file in selectedFiles)
                {
                    var stream = file.OpenReadStream(10 * 1024 * 1024); // 10 MB limit per file
                    streams.Add((file.Name, stream));
                }

                var result = await RequestComparisonGateway.StateRequestStreamsAsync(streams, cacheKey);
                batchId = result.BatchId;
                uploadedCount = result.FileCount;
                cacheHit = result.CacheHit;
            }
            finally
            {
                foreach (var (_, stream) in streams)
                {
                    await stream.DisposeAsync();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Upload failed: {ex.Message}";
            Logger.LogError(ex, "Failed to upload request files");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task StartComparison()
    {
        if (!CanStartComparison) return;

        isRunning = true;
        errorMessage = null;
        progressPercent = 0;
        statusMessage = "Starting comparison...";
        currentPhase = "Initializing";
        progressLog.Clear();
        cts = new CancellationTokenSource();

        try
        {
            using var http = HttpClientFactory.CreateClient();
            http.BaseAddress = new Uri(NavigationManager.BaseUri);

            var request = new CreateRequestComparisonJobRequest
            {
                RequestBatchId = batchId!,
                EndpointA = endpointA,
                EndpointB = endpointB,
                HeadersA = headersA.Where(h => !string.IsNullOrEmpty(h.Key))
                    .ToDictionary(h => h.Key, h => h.Value ?? ""),
                HeadersB = headersB.Where(h => !string.IsNullOrEmpty(h.Key))
                    .ToDictionary(h => h.Key, h => h.Value ?? ""),
                ContentTypeOverride = string.IsNullOrWhiteSpace(contentTypeOverride)
                    ? null
                    : contentTypeOverride,
                TimeoutMs = timeoutMs,
                MaxConcurrency = maxConcurrency,
                UseAlternateContractForEndpointB = endpointBUsesAlternateContract,
                AlternateContractProfileId = endpointBUsesAlternateContract
                    ? selectedAlternateContractProfileId
                    : null,
                // Configuration parity with Home
                ModelName = selectedModelName,
                IgnoreCollectionOrder = ignoreCollectionOrder,
                IgnoreStringCase = ignoreStringCase,
                IgnoreTrailingWhitespaceAtEnd = ignoreTrailingWhitespaceAtEnd,
                IgnoreXmlNamespaces = ignoreXmlNamespaces,
                EnableSemanticAnalysis = enableSemanticAnalysis,
                EnableEnhancedStructuralAnalysis = enableEnhancedStructuralAnalysis,
                IgnoreRules = IgnoreRules.Where(r => !string.IsNullOrWhiteSpace(r.PropertyPath))
                    .Select(r => new IgnoreRuleDto 
                    { 
                        PropertyPath = r.PropertyPath, 
                        IgnoreCompletely = r.IgnoreCompletely, 
                        IgnoreCollectionOrder = r.IgnoreCollectionOrder 
                    }).ToList(),
                MaskRules = MaskRules.Where(r => !string.IsNullOrWhiteSpace(r.PropertyPath))
                    .Select(r => new MaskRuleDto
                    {
                        PropertyPath = r.PropertyPath,
                        PreserveLastCharacters = r.PreserveLastCharacters,
                        MaskCharacter = string.IsNullOrWhiteSpace(r.MaskCharacter) ? "*" : r.MaskCharacter
                    }).ToList(),
                SmartIgnoreRules = new List<SmartIgnoreRuleDto>()
            };

            currentJobId = await RequestComparisonGateway.StartComparisonAsync(request, cts.Token);

            // Subscribe to SignalR progress updates
            if (!string.IsNullOrEmpty(currentJobId))
            {
                await ProgressService.SubscribeToJobAsync(currentJobId);
            }

            // Poll for status as fallback (reduced frequency since SignalR handles most updates)
            while (!cts.Token.IsCancellationRequested)
            {
                await Task.Delay(2000, cts.Token);
                
                var statusResponse = await RequestComparisonGateway.GetJobStatusAsync(currentJobId!);
                
                if (statusResponse == null) continue;

                if (statusResponse.Status == "Completed")
                {
                    var result = await RequestComparisonGateway.GetJobResultAsync(currentJobId!);
                    if (result != null)
                    {
                        await OnComparisonComplete.InvokeAsync(result);
                    }
                    break;
                }
                else if (statusResponse.Status == "Failed")
                {
                    errorMessage = statusResponse.Error ?? "Job failed";
                    break;
                }
                else if (statusResponse.Status == "Cancelled")
                {
                    statusMessage = "Job was cancelled";
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Cancelled";
        }
        catch (Exception ex)
        {
            errorMessage = $"Comparison failed: {ex.Message}";
            Logger.LogError(ex, "Request comparison failed");
        }
        finally
        {
            isRunning = false;
            await ProgressService.UnsubscribeAsync();
            cts?.Dispose();
            cts = null;
        }
    }

    private async Task CancelJob()
    {
        if (string.IsNullOrEmpty(currentJobId)) return;
        
        cts?.Cancel();
        
        try
        {
            await RequestComparisonGateway.CancelJobAsync(currentJobId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to cancel job");
        }
    }

    private void OnEndpointAChanged(string value)
    {
        selectedEndpointA = value;
        if (value != CustomEndpointValue)
        {
            endpointA = value;

            var option = availableEndpoints.FirstOrDefault(e => e.Url == value);
            if (option != null)
            {
                contentTypeOverride = string.IsNullOrWhiteSpace(option.ContentType)
                    ? null
                    : option.ContentType;

                headersA.Clear();

                foreach (var header in option.DefaultHeaders ?? Enumerable.Empty<KeyValuePair<string, string>>())
                {
                    headersA.Add(new HeaderPair { Key = header.Key, Value = header.Value });
                }
            }
        }
    }

    private void OnEndpointBChanged(string value)
    {
        selectedEndpointB = value;
        if (value != CustomEndpointValue)
        {
            endpointB = value;

            var option = availableEndpoints.FirstOrDefault(e => e.Url == value);
            if (option != null)
            {
                headersB.Clear();

                foreach (var header in option.DefaultHeaders ?? Enumerable.Empty<KeyValuePair<string, string>>())
                {
                    headersB.Add(new HeaderPair { Key = header.Key, Value = header.Value });
                }
            }
        }
    }

