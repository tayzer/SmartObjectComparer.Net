    private async Task HandleImportIgnoreRul(InputFileChangeEventArgs e)
    {
        importStatusMessage = string.Empty;
        importStatusIsError = false;
        var file = e.File;

        if (file == null) return;

        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024); // 10 MB limit
            var importedRules = await JsonSerializer.DeserializeAsync<List<IgnoreRule>>(stream, new JsonSerializerOptions(){PropertyNameCaseInsensitive = true});

            if (importedRules != null && importedRules.Any())
            {
                AddIgnoreRulesBatch(importedRules);
                importStatusMessage = $"Successfully imported {importedRules.Count} ignore rules.";
                importStatusIsError = false;
            }
            else
            {
                importStatusMessage = "No ignore rules found in the file.";
                importStatusIsError = true;
            }
        }
        catch (Exception ex)
        {
            importStatusMessage = $"Failed to import ignore rules: {ex.Message}";
            importStatusIsError = true;
            Logger.LogError(ex, "Failed to import ignore rules from file");
        }

        StateHasChanged();
    }

    private void HandleProgressUpdate(ComparisonProgressUpdate update)
    {
        // Ignore updates that don't belong to the current job
        if (update.JobId != currentJobId)
        {
            return;
        }

        InvokeAsync(() =>
        {
            // Only update if progress is moving forward (or it's a phase change)
            if (update.PercentComplete >= progressPercent || update.Phase.ToString() != currentPhase)
            {
                currentPhase = update.Phase.ToString();
                progressPercent = update.PercentComplete;
                statusMessage = update.Message;
                
                // Add to log
                progressLog.Add((update.Timestamp, update.Phase.ToString(), update.Message));
                
                // Keep only last 50 entries
                if (progressLog.Count > 50)
                {
                    progressLog = progressLog.Skip(progressLog.Count - 50).ToList();
                }
                
                StateHasChanged();
            }
        });
    }

