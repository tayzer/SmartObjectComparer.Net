    private void RefreshAlternateContractProfiles()
    {
        if (string.IsNullOrWhiteSpace(selectedModelName))
        {
            availableAlternateContractProfiles = new List<string>();
            selectedAlternateContractProfileId = null;
            return;
        }

        availableAlternateContractProfiles = AlternateContractProfileRegistry
            .GetProfileIds(selectedModelName)
            .ToList();

        if (!endpointBUsesAlternateContract)
        {
            selectedAlternateContractProfileId = null;
            return;
        }

        if (availableAlternateContractProfiles.Count == 1)
        {
            HandleAlternateContractProfileChanged(availableAlternateContractProfiles[0]);
            return;
        }

        if (!string.IsNullOrWhiteSpace(selectedAlternateContractProfileId) &&
            availableAlternateContractProfiles.Contains(selectedAlternateContractProfileId, StringComparer.Ordinal))
        {
            HandleAlternateContractProfileChanged(selectedAlternateContractProfileId);
            return;
        }

        selectedAlternateContractProfileId = null;
    }

